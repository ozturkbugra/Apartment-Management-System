@{
    ViewBag.Title = "Ayarlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Finansal Özet sayfasındaki renk değişkenlerini ve fontları aynı dilde koruyoruz
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-body: #f0f2f5;
        --grad-success: linear-gradient(135deg, #059669 0%, #34d399 100%);
        --grad-danger: linear-gradient(135deg, #dc2626 0%, #f87171 100%);
        --grad-primary: linear-gradient(135deg, #4f46e5 0%, #818cf8 100%);
        --grad-info: linear-gradient(135deg, #0891b2 0%, #22d3ee 100%);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--bg-body);
        background-image: radial-gradient(#444cf7 0.5px, transparent 0.5px), radial-gradient(#444cf7 0.5px, var(--bg-body) 0.5px);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
        color: #344767;
    }

    .pagetitle h1 {
        font-weight: 700;
        color: #1a1a1a;
    }

    /* FINANSAL ÖZET İLE UYUMLU CAM EFEKTLİ KARTLAR (GLASS-CARD) */
    .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        height: 100%;
        transition: all 0.3s ease;
    }

        .glass-card.info-glow:hover {
            box-shadow: 0 0 15px rgba(34, 211, 238, 0.4);
            border-color: #22d3ee;
        }

        .glass-card.primary-glow:hover {
            box-shadow: 0 0 15px rgba(129, 140, 248, 0.4);
            border-color: #818cf8;
        }

    .glass-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #fff;
    }

    /* MODERN BİLGİ KUTULARI */
    .inner-info-box {
        background-color: rgba(248, 249, 250, 0.7);
        border-left: 4px solid #4f46e5;
        border-radius: 8px;
        padding: 15px;
    }

        .inner-info-box.danger-side {
            border-left-color: #dc2626;
        }

    /* MODERN ON/OFF TOGGLE SWITCH (iOS STYLE) */
    .ios-switch-wrapper {
        display: inline-block;
    }

    .ios-switch {
        display: inline-block;
        height: 28px;
        position: relative;
        width: 52px;
    }

        .ios-switch input {
            display: none; /* Standart Checkbox gizleniyor */
        }

    .ios-slider {
        background-color: #e4e4e7;
        bottom: 0;
        cursor: pointer;
        left: 0;
        position: absolute;
        right: 0;
        top: 0;
        transition: .3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 34px;
    }

        .ios-slider:before {
            background-color: #fff;
            bottom: 3px;
            content: "";
            height: 22px;
            left: 3px;
            position: absolute;
            transition: .3s cubic-bezier(0.4, 0, 0.2, 1);
            width: 22px;
            border-radius: 50%;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }

    /* Aktif (On) Durumda Renk Değişimi */
    input:checked + .ios-slider {
        background: var(--grad-success);
    }

        /* Aktif (On) Durumda Yuvarlağın Kayma Hareketi */
        input:checked + .ios-slider:before {
            transform: translateX(24px);
        }

    /* İşlem Sırasında Switch Kilitleme Efekti */
    .disabled-switch {
        opacity: 0.4;
        pointer-events: none;
    }

    /* YEDEK KODLAR MODAL (açık tasarım) */
    .yedek-modal-box {
        background: #fff;
        color: #344767;
    }

    .yedek-modal-baslik {
        color: #1a1a1a;
    }

    .yedek-modal-aciklama {
        color: #6c757d;
    }

    .yedek-kod-item {
        background: #f1f3f5;
        color: #1a1a1a;
        padding: 8px 10px;
        border-radius: 8px;
        text-align: center;
    }
</style>

@{
    var ayar = ViewBag.Ayar;
    bool makbuzOnay = ayar?.MakbuzOnayKaldir ?? false;
    bool yoneticiAidat = ayar?.YoneticiAidatEkleme ?? false;
}

<div class="container-fluid py-4">

    <div class="pagetitle mb-4">
        <h1>Modül ve Yetki Ayarları</h1>
        <span class="text-muted">Apartman yönetim sistemi çalışma kurallarını özelleştirin.</span>
    </div>

    <div class="row g-4">
        <!-- 1. ÖZELLİK: MAKBUZ ONAY KALDIRMA (CAM KART) -->
        <div class="col-xl-6 col-md-12">
            <div class="card glass-card info-glow">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="d-flex align-items-center">
                                <div class="glass-icon shadow-sm me-3" style="background: var(--grad-info)">
                                    <i class="bi bi-file-earmark-lock2-fill"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">Makbuz Onay Kaldırma Yetkisi</h5>
                                    <small class="text-muted">Onaylı evrak güvenliği kısıtlaması</small>
                                </div>
                            </div>

                            <!-- iOS Tarzı Kayar Buton -->
                            <div class="ios-switch-wrapper">
                                <label class="ios-switch" for="switchMakbuz">
                                    <input type="checkbox" class="ayar-switch" id="switchMakbuz" data-alan="MakbuzOnayKaldir" @(makbuzOnay ? "checked" : "")>
                                    <span class="ios-slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Bilgilendirici Kurumsal Not Alanı -->
                    <div class="inner-info-box danger-side mt-2">
                        <h6 class="text-danger fw-bold mb-2"><i class="bi bi-shield-fill-exclamation me-1"></i> Sistem İşleyiş Notu:</h6>
                        <ul class="pl-3 mb-0 text-secondary small" style="line-height: 1.6; list-style-type: square;">
                            <li><b>KAPALI (Önerilen):</b> Onaylanmış olan makbuzlar kesinlikle silinemez veya iptal edilemez. Finansal veri manipülasyonunu engeller.</li>
                            <li><b>AÇIK:</b> Sistemdeki tüm kısıtlamalar devre dışı kalır. Yönetici onaylı makbuzları dilediği gibi silebilir.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. ÖZELLİK: YÖNETİCİ AİDAT EKLEME (CAM KART) -->
        <div class="col-xl-6 col-md-12">
            <div class="card glass-card primary-glow">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="d-flex align-items-center">
                                <div class="glass-icon shadow-sm me-3" style="background: var(--grad-primary)">
                                    <i class="bi bi-person-badge-fill"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">Yöneticiye Aidat Yansıtma</h5>
                                    <small class="text-muted">Yönetici muafiyet kontrol sistemi</small>
                                </div>
                            </div>

                            <!-- iOS Tarzı Kayar Buton -->
                            <div class="ios-switch-wrapper">
                                <label class="ios-switch" for="switchAidat">
                                    <input type="checkbox" class="ayar-switch" id="switchAidat" data-alan="YoneticiAidatEkleme" @(yoneticiAidat ? "checked" : "")>
                                    <span class="ios-slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Bilgilendirici Kurumsal Not Alanı -->
                    <div class="inner-info-box mt-2">
                        <h6 class="text-primary fw-bold mb-2"><i class="bi bi-info-circle-fill me-1"></i> Sistem İşleyiş Notu:</h6>
                        <ul class="pl-3 mb-0 text-secondary small" style="line-height: 1.6; list-style-type: square;">
                            <li><b>KAPALI (Önerilen):</b> Toplu aidat borçlandırması yapıldığında, "Yönetici" rolündeki daire sahipleri sistem tarafından otomatik olarak muaf tutulur ve aidat yazılmaz.</li>
                            <li><b>AÇIK:</b> Dönemsel aidat işletildiğinde binadaki diğer tüm daireler gibi yönetici dairesine de aidat borcu yansıtılır.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. ÖZELLİK: İKİ ADIMLI DOĞRULAMA (GOOGLE AUTHENTICATOR) -->
    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="card glass-card primary-glow">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="glass-icon shadow-sm me-3" style="background: var(--grad-success)">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">İki Adımlı Doğrulama (Google Authenticator)</h5>
                            <small class="text-muted">Girişlerinizi tek kullanımlık kod ile ekstra koruma altına alın</small>
                        </div>
                    </div>

                    @if (ViewBag.IkiAdimAktif == true)
                    {
                        <div class="inner-info-box mt-2" style="border-left-color:#059669;">
                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                <div>
                                    <h6 class="text-success fw-bold mb-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Aktifleştirildi
                                    </h6>
                                    <span class="text-secondary small">
                                        Hesabınız iki adımlı doğrulama ile korunuyor. Her girişte Authenticator kodunuz istenecektir.
                                    </span>
                                </div>
                                <button id="btnIkiAdimKapat" class="btn btn-outline-danger btn-sm flex-shrink-0">
                                    <i class="bi bi-x-circle me-1"></i> Devre Dışı Bırak
                                </button>
                            </div>
                        </div>

                        <div class="inner-info-box mt-3">
                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                <div>
                                    <h6 class="text-primary fw-bold mb-1">
                                        <i class="bi bi-key-fill me-1"></i> Yedek Kodlar
                                    </h6>
                                    <span class="text-secondary small">
                                        Telefonunuza erişemediğinizde giriş için kullanılır.
                                        Kalan kullanılabilir kod: <b>@ViewBag.IkiAdimYedekKalan</b>
                                    </span>
                                </div>
                                <button id="btnYedekYenile" class="btn btn-outline-primary btn-sm flex-shrink-0">
                                    <i class="bi bi-arrow-repeat me-1"></i> Yeni Kodlar Üret
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-4 align-items-center">
                            <div class="col-md-4 text-center">
                                <div id="qrcode" class="d-inline-block p-2 bg-white rounded shadow-sm"></div>
                            </div>
                            <div class="col-md-8">
                                <div class="inner-info-box">
                                    <ol class="pl-3 mb-3 text-secondary small" style="line-height:1.8;">
                                        <li>Telefonunuza <b>Google Authenticator</b> (veya benzeri) uygulamasını kurun.</li>
                                        <li>Uygulamada <b>QR kodu tarayın</b> ya da aşağıdaki anahtarı elle girin.</li>
                                        <li>Uygulamada beliren <b>6 haneli kodu</b> aşağıya yazıp aktifleştirin.</li>
                                    </ol>
                                    <div class="mb-3">
                                        <label class="form-label small text-muted mb-1">Elle giriş anahtarı:</label>
                                        <code class="d-block p-2 bg-light rounded" style="font-size:0.95rem; letter-spacing:1px;">@ViewBag.IkiAdimSecret</code>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-sm-6">
                                            <input type="text" id="ikiAdimKod" class="form-control text-center"
                                                   inputmode="numeric" maxlength="6" placeholder="6 haneli kod"
                                                   style="letter-spacing:0.4rem; font-weight:600;">
                                        </div>
                                        <div class="col-sm-6">
                                            <button id="btnIkiAdimAktiflestir" class="btn btn-success w-100">
                                                <i class="bi bi-shield-check me-1"></i> Aktifleştir
                                            </button>
                                        </div>
                                    </div>
                                    <div id="ikiAdimMesaj" class="small mt-2"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- YEDEK KODLAR MODAL (aktifleştirme ve yenileme sonrası kodları bir kez gösterir) -->
<div id="yedekModal" style="display:none; position:fixed; inset:0; z-index:1080; background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
    <div class="yedek-modal-box" style="border-radius:16px; max-width:420px; width:92%; padding:28px; box-shadow:0 10px 40px rgba(0,0,0,0.25);">
        <h5 class="fw-bold yedek-modal-baslik mb-1"><i class="bi bi-key-fill text-primary me-1"></i> Yedek Kodlarınız</h5>
        <p class="yedek-modal-aciklama small mb-3">
            Bu kodları güvenli bir yerde saklayın. <b>Her kod yalnızca bir kez</b> kullanılabilir ve bu ekran
            tekrar gösterilmeyecektir. Authenticator uygulamanıza erişemezseniz bu kodlarla giriş yapabilirsiniz.
        </p>
        <div id="yedekKodListe" class="mb-3" style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-family:monospace; font-size:1.05rem; letter-spacing:1px;"></div>
        <div class="d-flex gap-2">
            <button type="button" id="btnKodKopyala" class="btn btn-outline-secondary btn-sm flex-grow-1"><i class="bi bi-clipboard me-1"></i> Kopyala</button>
            <button type="button" id="btnKodKapat" class="btn btn-success btn-sm flex-grow-1">Kaydettim, Kapat</button>
        </div>
    </div>
</div>

@if (ViewBag.IkiAdimAktif != true)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        (function () {
            var otpUri = "@Html.Raw(ViewBag.IkiAdimOtpUri)";
            new QRCode(document.getElementById("qrcode"), {
                text: otpUri,
                width: 180,
                height: 180,
                correctLevel: QRCode.CorrectLevel.M
            });
        })();
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('.ayar-switch').change(function () {
            var checkbox = $(this);
            var wrapper = checkbox.closest('.ios-switch');
            var alanAdi = checkbox.data('alan');
            var durum = checkbox.is(':checked');

            // Arka planda istek işlenirken çift tıklamayı önlemek için kilitliyoruz
            wrapper.addClass('disabled-switch');

            $.ajax({
                url: '/Ayarlar/AyarlariGuncelle',
                type: 'POST',
                data: {
                    alanAdi: alanAdi,
                    durum: durum
                },
                success: function (response) {
                    wrapper.removeClass('disabled-switch');
                    if (response.success) {
                        console.log(response.message);
                    } else {
                        alert(response.message);
                        checkbox.prop('checked', !durum); // Hata durumunda butonu eski konumuna geri çek
                    }
                },
                error: function () {
                    wrapper.removeClass('disabled-switch');
                    alert('Sistem hatası oluştu, lütfen tekrar deneyin.');
                    checkbox.prop('checked', !durum); // Hata durumunda butonu eski konumuna geri çek
                }
            });
        });

        // --- İKİ ADIMLI DOĞRULAMA: AKTİFLEŞTİR ---
        $('#btnIkiAdimAktiflestir').click(function () {
            var btn = $(this);
            var kod = $('#ikiAdimKod').val();
            var mesaj = $('#ikiAdimMesaj');

            if (!kod || kod.length !== 6) {
                mesaj.html('<span class="text-danger">Lütfen 6 haneli kodu giriniz.</span>');
                return;
            }

            btn.prop('disabled', true);
            mesaj.html('<span class="text-muted">Doğrulanıyor...</span>');

            $.ajax({
                url: '/Ayarlar/IkiAdimAktiflestir',
                type: 'POST',
                data: { kod: kod },
                success: function (response) {
                    if (response.success) {
                        mesaj.html('<span class="text-success">' + response.message + '</span>');
                        // Yedek kodları bir kez göster; modal kapanınca sayfayı yenile.
                        yedekModalGoster(response.recoveryCodes, true);
                    } else {
                        btn.prop('disabled', false);
                        mesaj.html('<span class="text-danger">' + response.message + '</span>');
                    }
                },
                error: function () {
                    btn.prop('disabled', false);
                    mesaj.html('<span class="text-danger">Sistem hatası oluştu, lütfen tekrar deneyin.</span>');
                }
            });
        });

        // --- YEDEK KODLARI YENİLE ---
        $('#btnYedekYenile').click(function () {
            if (!confirm('Yeni yedek kodlar üretilecek ve eski kodlarınız geçersiz olacaktır. Devam edilsin mi?')) {
                return;
            }
            var btn = $(this);
            btn.prop('disabled', true);

            $.ajax({
                url: '/Ayarlar/IkiAdimYedekYenile',
                type: 'POST',
                success: function (response) {
                    btn.prop('disabled', false);
                    if (response.success) {
                        yedekModalGoster(response.recoveryCodes, true);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    btn.prop('disabled', false);
                    alert('Sistem hatası oluştu, lütfen tekrar deneyin.');
                }
            });
        });

        // --- YEDEK KODLAR MODAL YARDIMCILARI ---
        var yedekReloadOnClose = false;
        function yedekModalGoster(kodlar, reloadOnClose) {
            if (!kodlar || !kodlar.length) { if (reloadOnClose) location.reload(); return; }
            yedekReloadOnClose = reloadOnClose === true;
            var html = '';
            $.each(kodlar, function (i, k) {
                html += '<div class="yedek-kod-item">' + k + '</div>';
            });
            $('#yedekKodListe').html(html);
            $('#yedekModal').css('display', 'flex').data('kodlar', kodlar.join('\n'));
        }

        $('#btnKodKapat').click(function () {
            $('#yedekModal').hide();
            if (yedekReloadOnClose) location.reload();
        });

        $('#btnKodKopyala').click(function () {
            var metin = $('#yedekModal').data('kodlar') || '';
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(metin);
            } else {
                var ta = document.createElement('textarea');
                ta.value = metin; document.body.appendChild(ta); ta.select();
                document.execCommand('copy'); document.body.removeChild(ta);
            }
            $(this).html('<i class="bi bi-check2 me-1"></i> Kopyalandı');
        });

        // --- İKİ ADIMLI DOĞRULAMA: DEVRE DIŞI BIRAK ---
        $('#btnIkiAdimKapat').click(function () {
            if (!confirm('İki adımlı doğrulamayı devre dışı bırakmak istediğinize emin misiniz?')) {
                return;
            }
            var btn = $(this);
            btn.prop('disabled', true);

            $.ajax({
                url: '/Ayarlar/IkiAdimKapat',
                type: 'POST',
                success: function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        btn.prop('disabled', false);
                        alert(response.message);
                    }
                },
                error: function () {
                    btn.prop('disabled', false);
                    alert('Sistem hatası oluştu, lütfen tekrar deneyin.');
                }
            });
        });
    });
</script>