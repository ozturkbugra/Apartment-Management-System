@{
    ViewBag.Title = "Sakin Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-body: #f0f2f5;
        --card-shadow: 0 10px 30px rgba(0,0,0,0.08);
        --primary-grad: linear-gradient(135deg, #4f46e5 0%, #818cf8 100%);
        --success-grad: linear-gradient(135deg, #059669 0%, #34d399 100%);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--bg-body);
        color: #344767;
    }

    /* Kart Yapısı */
    .edit-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        max-width: 1050px; /* 800px'den 1050px'e çıkarıldı */
        margin: 40px auto;
        border: none;
    }

    .card-header-custom {
        background: var(--primary-grad);
        padding: 30px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .daire-badge {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(5px);
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.3);
    }

    .daire-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        opacity: 0.8;
    }

    .daire-num {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
    }

    /* Form Elemanları */
    .form-body {
        padding: 40px;
    }

    .form-label-custom {
        font-size: 0.85rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-text {
        background: #f8f9fa;
        border: 1px solid #e2e8f0;
        border-right: none;
        color: #4f46e5;
        border-radius: 10px 0 0 10px;
    }

    .form-control, .form-select {
        border: 1px solid #e2e8f0;
        padding: 12px 15px;
        font-size: 1rem;
        border-radius: 0 10px 10px 0; /* Input group için */
    }

        /* Select için border radius düzeltmesi (Input group değilse) */
        .form-select:not(.rounded-end) {
            border-radius: 10px;
        }

        .form-control:focus, .form-select:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

    /* Butonlar */
    .btn-update {
        background: var(--success-grad);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
        box-shadow: 0 4px 15px rgba(5, 150, 105, 0.3);
        transition: transform 0.2s;
    }

        .btn-update:hover {
            transform: translateY(-3px);
            color: white;
        }

    .btn-cancel {
        background: #f1f5f9;
        color: #64748b;
        border: none;
        padding: 15px;
        border-radius: 12px;
        font-weight: 600;
        width: 100%;
        transition: background 0.2s;
        text-align: center;
        text-decoration: none;
        display: block;
    }

        .btn-cancel:hover {
            background: #e2e8f0;
            color: #475569;
        }
</style>

<div class="container-fluid">

    <div class="edit-card">
        <div class="card-header-custom">
            <div>
                <a href="/AnaSayfa/Sakinler" class="btn btn-outline-light btn-sm mb-2">Geri Dön</a>
                <h4 class="fw-bold mb-1">Kişi Bilgilerini Düzenle</h4>
                <p class="mb-0 opacity-75 small">Daire sakini bilgilerini güncelleyin.</p>
            </div>
            <div class="daire-badge">
                <span class="daire-label">Daire</span>
                <span class="daire-num">@ViewBag.s.DaireNo</span>
            </div>
        </div>

        <div class="form-body">
            <div class="row">
                <!-- SOL KOLON: MEVCUT ANA DAİRE GÜNCELLEME FORMU -->
                <div class="col-lg-6 border-end pe-lg-4">
                    <h5 class="fw-bold mb-4 text-primary"><i class="bi bi-house-gear-fill me-2"></i>Ana Daire Bilgileri</h5>

                    <form action="/AnaSayfa/SakinDuzenle" method="post">
                        <input type="hidden" name="DaireID" value="@ViewBag.s.DaireID" />

                        <div class="mb-4">
                            <label class="form-label-custom">Ad Soyad (Abone)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                                <input type="text" name="AdSoyad" value="@ViewBag.s.AdSoyad" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label-custom">Telefon</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>
                                    <input type="text" name="Telefon" value="@ViewBag.s.Telefon" class="form-control" maxlength="10" placeholder="5XXXXXXXXX" required />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">TC KİMLİK No</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                                    <input type="text" name="TC" value="@ViewBag.s.TC" class="form-control" maxlength="11" placeholder="11 Haneli TC" required />
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label-custom">DAİRE Durumu</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-house-check"></i></span>
                                    <select name="DaireDurum" class="form-select rounded-end">
                                        <option value="Ev Sahibi" @(ViewBag.s.DaireDurum == "Ev Sahibi" ? "selected" : "")>Ev Sahibi</option>
                                        <option value="Kiracı" @(ViewBag.s.DaireDurum == "Kiracı" ? "selected" : "")>Kiracı</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-custom">YÖNETİMDE Mİ?</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                    <select name="YonetimdeMi" class="form-select rounded-end">
                                        <option value="H" @(ViewBag.s.YonetimdeMi == "H" ? "selected" : "")>HAYIR</option>
                                        <option value="E" @(ViewBag.s.YonetimdeMi == "E" ? "selected" : "")>EVET</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- YENİ EKLENEN AÇIKLAMA TEXTAREA ALANI -->
                        <div class="mb-4">
                            <label class="form-label-custom">Daire Hakkında Özel Notlar / Açıklama</label>
                            <div class="input-group">
                                <span class="input-group-text align-items-start pt-2"><i class="bi bi-sticky-fill"></i></span>
                                <textarea name="Aciklama" class="form-control" rows="4" placeholder="Daireye veya sakine dair özel notlarınızı buraya satır atlayarak yazabilirsiniz..." style="border-radius: 0 10px 10px 0; resize: vertical;">@ViewBag.s.Aciklama</textarea>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-6">
                                <a href="/AnaSayfa/Sakinler" class="btn-cancel">İptal Et</a>
                            </div>
                            <div class="col-6">
                                <button type="submit" class="btn-update">
                                    <i class="bi bi-check-lg me-2"></i> Güncelle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- SAĞ KOLON: YENİ TABLOYA TOPLU KİŞİ/EV SAHİBİ EKLEME ALANI -->
                <div class="col-lg-6 ps-lg-4 mt-4 mt-lg-0">
                    <h5 class="fw-bold mb-3 text-success"><i class="bi bi-people-fill me-2"></i>Daireye Ait Diğer Kişiler / Ev Sahibi</h5>

                    <!-- Yeni Tablo İçin Hızlı Ekleme Formu -->
                    <form action="/AnaSayfa/EkSakinEkle" method="post" class="p-3 bg-light rounded-3 mb-4 border">
                        <input type="hidden" name="DaireID" value="@ViewBag.s.DaireID" />
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label-custom" style="font-size:0.75rem;">Ad Soyad</label>
                                <input type="text" name="AdSoyad" class="form-control form-control-sm" placeholder="Örn: Mehmet Yılmaz" required style="border-radius:6px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" style="font-size:0.75rem;">TC</label>
                                <input type="text" name="TC" class="form-control form-control-sm" placeholder="TC" maxlength="11" required style="border-radius:6px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" style="font-size:0.75rem;">Telefon</label>
                                <input type="text" name="Telefon" class="form-control form-control-sm" maxlength="10" placeholder="5XXXXXXXXX" style="border-radius:6px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom" style="font-size:0.75rem;">Konumu / Durumu</label>
                                <select name="DaireDurum" class="form-select form-select-sm" style="border-radius:6px;">
                                    <option value="Ev Sahibi">Ev Sahibi</option>
                                    <option value="Eş">Eş</option>
                                    <option value="Çocuk">Çocuk</option>
                                    <option value="Aile Bireyi">Aile Bireyi</option>
                                    <option value="Diğer">Diğer</option>
                                </select>
                            </div>
                            <div class="col-12 mt-3">
                                <button type="submit" class="btn btn-success btn-sm w-100" style="border-radius:8px; padding:8px;">
                                    <i class="bi bi-plus-lg me-1"></i> Bu Kişiyi Daireye Ekle
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Yeni Tablodan Gelen Verilerin Listesi -->
                    <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr style="font-size:0.8rem;">
                                    <th>Ad Soyad</th>
                                    <th>Telefon</th>
                                    <th>TC</th>
                                    <th>Durum</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody style="font-size:0.85rem;">
                                @if (ViewBag.EkSakinler != null && ViewBag.EkSakinler.Count > 0)
                                {
                                    foreach (var kisi in ViewBag.EkSakinler)
                                    {
                                        // Telefon numarasını 05XX XXX XX XX formatına dönüştürme kontrolü
                                        string hamTelefon = kisi.Telefon;
                                        string formatliTelefon = "-";

                                        if (!string.IsNullOrEmpty(hamTelefon) && hamTelefon.Length == 10)
                                        {
                                            // Başına 0 ekleyip maskeliyoruz: 0506 157 6556
                                            formatliTelefon = string.Format("0{0} {1} {2}", hamTelefon.Substring(0, 3), hamTelefon.Substring(3, 3), hamTelefon.Substring(6, 4));
                                        }

                                        <tr>
                                            <td class="fw-semibold">@kisi.AdSoyad</td>
                                            <td class="text-muted">@formatliTelefon</td>
                                            <td>@kisi.TC</td>
                                            <td>
                                                <span class="badge @(kisi.DaireDurum == "Ev Sahibi" ? "bg-info text-dark" : "bg-secondary")">
                                                    @kisi.DaireDurum
                                                </span>
                                            </td>

                                            <td class="text-end">
                                                <a href="/AnaSayfa/EkSakinSil?id=@kisi.ID&daireId=@kisi.DaireID" class="text-danger px-2" onclick="return confirm('Bu kişiyi silmek istediğinize emin misiniz?')">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">Bu daireye ait henüz ek bir kişi tanımlanmamış.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>