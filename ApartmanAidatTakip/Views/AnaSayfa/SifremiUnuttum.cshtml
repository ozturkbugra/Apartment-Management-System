@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>Apartman Aidat Yazılımı - Şifremi Unuttum</title>

    <link href="/Content/Admin/assets/img/favicon.png" rel="icon">
    <link href="/Content/Admin/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="/Content/Admin/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/Content/Admin/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="/Content/Admin/assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet">

    <link href="/Content/Admin/assets/css/darkmode.css" rel="stylesheet">
    <script src="/Content/Admin/assets/js/darkmode.js"></script>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f6fa;
        }

        .container {
            max-width: 400px;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .card-body {
            padding: 2rem;
        }

        .form-label {
            font-weight: 500;
        }

        .form-control {
            border-radius: 10px;
        }

        .btn-success {
            border-radius: 10px;
            font-weight: 600;
            background-color: #28a745;
        }

            .btn-success:hover {
                background-color: #218838;
            }

        .small {
            font-size: 0.875rem;
        }
    </style>
</head>

<body>
    <main>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <div class="container d-flex flex-column align-items-center justify-content-center min-vh-100">
            <section class="section register d-flex flex-column align-items-center justify-content-center py-4">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 d-flex flex-column align-items-center justify-content-center">

                            <div class="card">
                                <div class="card-body">

                                    <div class="text-center mb-3">
                                        <img src="~/Content/Admin/assets/img/logo.png" width="150" alt="">
                                    </div>
                                    <h5 class="card-title text-center mb-2">Şifremi Unuttum</h5>
                                    <p class="text-center text-muted small mb-3">
                                        Hesabınızı belirtin; kimliğinizi Google Authenticator kodunuz veya yedek kodunuzla
                                        doğrulayıp yeni şifrenizi belirleyeceksiniz.
                                    </p>

                                    <form method="post" action="/AnaSayfa/SifremiUnuttum" class="row g-3">

                                        <div class="col-12">
                                            <label for="BinaID" class="form-label">Bina Adı</label>
                                            <select class="form-select" name="BinaID" id="BinaID" required>
                                                <option value="">Bina Seçiniz</option>
                                                @foreach (var item in ViewBag.Binalar)
                                                {
                                                    <option value="@item.BinaID">@item.BinaKullaniciAdi</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label for="KullaniciAdi" class="form-label">Kullanıcı Adı</label>
                                            <input type="text" name="KullaniciAdi" class="form-control" id="KullaniciAdi" required>
                                        </div>

                                        @if (!string.IsNullOrEmpty(ViewBag.Uyari))
                                        {
                                            <div class="col-12">
                                                <div class="alert alert-danger text-center mb-0">@ViewBag.Uyari</div>
                                            </div>
                                        }

                                        <div class="col-12">
                                            <button class="btn btn-success w-100" type="submit">Devam Et</button>
                                        </div>

                                        <div class="col-12 text-center">
                                            <p class="small mb-0"><a href="/AnaSayfa/Login">Girişe geri dön</a></p>
                                        </div>
                                    </form>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script src="/Content/Admin/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#BinaID').select2({
                width: '100%',
                placeholder: 'Bina Seçiniz',
                allowClear: true
            });
        });
    </script>
</body>

</html>
