@{
    ViewBag.Title = "Daire Sakinleri";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string tl = "₺";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-body: #f0f2f5;
        --primary-grad: linear-gradient(135deg, #4f46e5 0%, #818cf8 100%);
        --success-grad: linear-gradient(135deg, #059669 0%, #34d399 100%);
        --card-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--bg-body);
        color: #344767;
    }

    /* Üst Aksiyon Alanı */
    .action-bar {
        background: #fff;
        padding: 20px;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn-action {
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 500;
        transition: transform 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-action:hover {
            transform: translateY(-2px);
        }

    .btn-gradient-success {
        background: var(--success-grad);
        color: white;
        box-shadow: 0 4px 15px rgba(5, 150, 105, 0.3);
    }

    .btn-gradient-primary {
        background: var(--primary-grad);
        color: white;
        box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
    }

    .btn-outline-custom {
        border: 2px solid #e2e8f0;
        color: #64748b;
        background: transparent;
    }

        .btn-outline-custom:hover {
            border-color: #059669;
            color: #059669;
            background: #f0fdf4;
        }

    /* Tablo Kartı */
    .table-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        padding: 0;
        overflow: hidden;
    }

    .modern-table thead th {
        background-color: #f8f9fa;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 1px solid #e2e8f0;
        padding: 18px 20px;
    }

    .modern-table tbody td {
        padding: 18px 20px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

    .modern-table tbody tr:last-child td {
        border-bottom: none;
    }

    .modern-table tbody tr:hover {
        background-color: #f8fafc;
    }

    /* Avatar Stili */
    .user-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        margin-right: 15px;
    }

    /* Rozetler */
    .badge-soft {
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .badge-soft-success {
        background: #dcfce7;
        color: #166534;
    }

    .badge-soft-info {
        background: #e0f2fe;
        color: #075985;
    }

    .badge-soft-warning {
        background: #ffedd5;
        color: #9a3412;
    }

    .badge-soft-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    /* Form Inputları */
    .form-floating-custom .form-control {
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        padding: 10px 15px;
    }

        .form-floating-custom .form-control:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

    .text-helper {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 5px;
        display: block;
    }

    /* Liste araç çubuğu + sayfalama */
    .list-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        padding: 15px 20px;
        border-bottom: 1px solid #f1f5f9;
    }

        .list-toolbar .form-control, .list-toolbar .form-select {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 0.9rem;
        }

    .search-box {
        min-width: 240px;
        max-width: 340px;
        flex: 1;
    }

    .list-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        padding: 15px 20px;
        border-top: 1px solid #f1f5f9;
    }

    .pagination-custom {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

        .pagination-custom button {
            min-width: 36px;
            height: 36px;
            border: 1px solid #e2e8f0;
            background: #fff;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #475569;
        }

            .pagination-custom button.active {
                background: #4f46e5;
                border-color: #4f46e5;
                color: #fff;
            }

            .pagination-custom button:disabled {
                opacity: .4;
                cursor: default;
            }

    .no-result-row td {
        text-align: center;
        color: #94a3b8;
        padding: 30px;
    }

    /* ===================== DARK MODE (ayrı katman) ===================== */
    html.dark-mode .table-card { background: var(--dm-surface) !important; box-shadow: 0 10px 30px rgba(0,0,0,0.35) !important; }
    html.dark-mode .list-toolbar,
    html.dark-mode .list-footer { background: var(--dm-surface) !important; border-color: var(--dm-border) !important; }
    html.dark-mode .list-toolbar .form-control,
    html.dark-mode .list-toolbar .form-select { background: var(--dm-surface-2) !important; border-color: var(--dm-border) !important; color: var(--dm-text) !important; }
    html.dark-mode .modern-table thead th { background: var(--dm-surface-2) !important; color: var(--dm-muted) !important; border-bottom-color: var(--dm-border) !important; }
    html.dark-mode .modern-table tbody td { color: var(--dm-text) !important; border-bottom-color: var(--dm-border) !important; }
    html.dark-mode .modern-table tbody tr:hover { background: rgba(109,139,255,0.08) !important; }
    html.dark-mode .pagination-custom button { background: var(--dm-surface-2) !important; border-color: var(--dm-border) !important; color: var(--dm-text) !important; }
    html.dark-mode .pagination-custom button.active { background: var(--dm-primary) !important; border-color: var(--dm-primary) !important; color: #fff !important; }
</style>

<div class="container-fluid py-4">

    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h3 class="fw-bold mb-1">Daire Sakinleri</h3>
            <span class="text-muted small">Apartman sakinlerini yönetin ve düzenleyin.</span>
        </div>
    </div>

    <div class="action-bar">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-light rounded-circle p-2 text-primary">
                <i class="bi bi-people-fill fs-4"></i>
            </div>
            <h5 class="mb-0 fw-bold text-dark">Sakin Listesi</h5>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            @if (ViewBag.Durum == true)
            {
                <a href="~/Content/Admin/assets/document/excel format.xlsx" class="btn btn-action btn-outline-custom">
                    <i class="bi bi-file-earmark-excel"></i> Format İndir
                </a>
                <button type="button" class="btn btn-action btn-gradient-primary" data-bs-toggle="modal" data-bs-target="#verticalycentered1">
                    <i class="bi bi-upload"></i> Excel Yükle
                </button>
                <button type="button" class="btn btn-action btn-gradient-success" data-bs-toggle="modal" data-bs-target="#verticalycentered">
                    <i class="bi bi-person-plus-fill"></i> Yeni Sakin Ekle
                </button>
            }
            else
            {
                <div class="alert alert-warning mb-0 py-2 px-3 d-flex align-items-center small">
                    <i class="bi bi-lock-fill me-2"></i> İşlem yetkiniz kısıtlanmıştır.
                </div>
            }
        </div>
    </div>

    <div class="table-card">

        <div class="list-toolbar">
            <input type="text" id="searchInput" class="form-control search-box" placeholder="🔍 Daire no, ad soyad veya Ev Sahibi / Kiracı ara...">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Sayfa başına</span>
                <select id="perPageSelect" class="form-select" style="width:auto;">
                    <option value="10" selected>10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="40">40</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table modern-table mb-0" id="dataTable">
                <thead>
                    <tr>
                        <th scope="col">KİŞİ BİLGİSİ</th>
                        <th scope="col">İLETİŞİM & TC</th>
                        <th scope="col">DURUM</th>
                        <th scope="col">YÖNETİM</th>
                        <th scope="col">GÜNCEL BORÇ</th>
                        <th scope="col" class="text-end">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.Daireler)
                    {
                        // Baş harfi alma güvenliği
                        string init = !string.IsNullOrEmpty(item.AdSoyad) ? item.AdSoyad.Substring(0, 1).ToUpper() : "?";

                        // Telefon numarasını formatlama kontrolü
                        string hamTelefon = item.Telefon;
                        string formatliTelefon = "-";

                        if (!string.IsNullOrEmpty(hamTelefon) && hamTelefon.Length == 10)
                        {
                            formatliTelefon = string.Format("0{0} {1} {2}", hamTelefon.Substring(0, 3), hamTelefon.Substring(3, 3), hamTelefon.Substring(6, 4));
                        }

                        // Arama yalnızca daire no + ad soyad + durum (Ev Sahibi/Kiracı) üzerinden; telefon/TC/borç dahil değil.
                        string aramaMetni = (("" + item.DaireNo + " " + item.AdSoyad + " " + item.DaireDurum)).ToLower();

                        <tr data-search="@aramaMetni">
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar shadow-sm">@init</div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.AdSoyad</div>
                                        <div class="small text-muted"><i class="bi bi-house-door-fill text-primary"></i> Daire No: @item.DaireNo</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark"><i class="bi bi-telephone me-1"></i> @formatliTelefon</div>
                                <div class="small text-muted mt-1"><i class="bi bi-card-heading me-1"></i> @item.TC</div>
                            </td>
                            <td>
                                @if (item.DaireDurum == "Ev Sahibi")
                                {
                                    <span class="badge badge-soft-success"><i class="bi bi-house-check me-1"></i> Ev Sahibi</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-info"><i class="bi bi-person-workspace me-1"></i> Kiracı</span>
                                }
                            </td>
                            <td>
                                @if (item.YonetimdeMi == "E")
                                {
                                    <span class="badge badge-soft-warning"><i class="bi bi-star-fill me-1"></i> Yönetimde</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (item.Borc > 0)
                                {
                                    <span class="fw-bold text-danger">@item.Borc.ToString("N2") @tl</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-success">0,00 @tl</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/AnaSayfa/SakinDuzenle/@item.DaireID" class="btn btn-sm btn-light text-primary border shadow-sm">
                                    <i class="bi bi-pencil-square"></i> Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="list-footer">
            <span class="text-muted small" id="pageInfo"></span>
            <div class="pagination-custom" id="pagination"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="verticalycentered" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary"><i class="bi bi-person-plus-fill me-2"></i>Daire Sakini Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/AnaSayfa/SakinEkle" method="post" class="p-3 js-lock">
                <div class="modal-body form-floating-custom">

                    <div class="mb-3">
                        <label class="fw-bold small mb-1">Ad Soyad</label>
                        <input type="text" name="AdSoyad" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold small mb-1">Telefon</label>
                        <input type="text" name="Telefon" class="form-control" placeholder="5XXXXXXXXX" maxlength="10" required />
                        <span class="text-helper text-danger"><i class="bi bi-exclamation-circle"></i> Başında 0 olmadan 10 hane (Sisteme giriş için gereklidir).</span>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold small mb-1">TC Kimlik No</label>
                        <input type="text" name="TC" class="form-control" placeholder="11 Haneli TC" maxlength="11" required />
                        <span class="text-helper text-danger"><i class="bi bi-exclamation-circle"></i> Borç sorgulama ekranı için gereklidir.</span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="fw-bold small mb-1">Durumu</label>
                            <select name="DaireDurum" class="form-select form-control">
                                <option value="Ev Sahibi">Ev Sahibi</option>
                                <option value="Kiracı">Kiracı</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="fw-bold small mb-1">Yönetimde mi?</label>
                            <select name="YonetimdeMi" class="form-select form-control">
                                <option value="H">Hayır</option>
                                <option value="E">Evet</option>
                            </select>
                        </div>
                    </div>
                    <span class="text-helper text-muted mt-2"><i class="bi bi-info-circle"></i> Yönetimde olan dairelere otomatik aidat yansımaz.</span>

                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light text-muted" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-gradient-success px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="verticalycentered1" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-success"><i class="bi bi-file-earmark-spreadsheet-fill me-2"></i>Excel ile Toplu Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/AnaSayfa/SakinEkleExcel" method="post" enctype="multipart/form-data" class="p-3 js-lock">
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-cloud-upload display-1 text-muted opacity-25"></i>
                        <p class="small text-muted mt-2">İndirdiğiniz formatta hazırladığınız Excel dosyasını seçiniz.</p>
                    </div>
                    <input type="file" class="form-control" name="file" required accept=".xlsx, .xls" />
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light text-muted" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-gradient-success px-4">Yüklemeyi Başlat</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function() {

        // ============================================================
        // ARAMA + SAYFALAMA (daire no / ad soyad / Ev Sahibi-Kiracı)
        // ============================================================
        var allRows = Array.prototype.slice.call(document.querySelectorAll('#dataTable tbody tr'));
        var filtered = allRows.slice();
        var perPage = 10;
        var currentPage = 1;

        var $tbody = $('#dataTable tbody');
        var noResultRow = $('<tr class="no-result-row"><td colspan="6">Kayıt bulunamadı.</td></tr>')[0];

        function makeBtn(label, disabled, onClick) {
            var b = document.createElement('button');
            b.type = 'button';
            b.textContent = label;
            b.disabled = disabled;
            b.addEventListener('click', onClick);
            return b;
        }

        function render() {
            if (noResultRow.parentNode) noResultRow.parentNode.removeChild(noResultRow);
            allRows.forEach(function (r) { r.style.display = 'none'; });

            if (filtered.length === 0) {
                $tbody.append(noResultRow);
                $('#pagination').empty();
                $('#pageInfo').text('0 kayıt');
                return;
            }

            var totalPages = Math.ceil(filtered.length / perPage);
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            var start = (currentPage - 1) * perPage;
            var end = Math.min(start + perPage, filtered.length);
            for (var i = start; i < end; i++) { filtered[i].style.display = ''; }

            $('#pageInfo').text((start + 1) + '-' + end + ' / ' + filtered.length + ' kayıt');

            var $pag = $('#pagination').empty();
            if (totalPages > 1) {
                $pag.append(makeBtn('«', currentPage === 1, function () { currentPage--; render(); }));
                var startP = Math.max(1, currentPage - 2);
                var endP = Math.min(totalPages, startP + 4);
                startP = Math.max(1, endP - 4);
                for (var p = startP; p <= endP; p++) {
                    (function (pg) {
                        var b = makeBtn(pg, false, function () { currentPage = pg; render(); });
                        if (pg === currentPage) b.className = 'active';
                        $pag.append(b);
                    })(p);
                }
                $pag.append(makeBtn('»', currentPage === totalPages, function () { currentPage++; render(); }));
            }
        }

        $('#searchInput').on('input', function () {
            var q = this.value.toLowerCase().trim();
            filtered = q === '' ? allRows.slice() : allRows.filter(function (r) {
                return (r.getAttribute('data-search') || '').indexOf(q) !== -1;
            });
            currentPage = 1;
            render();
        });

        $('#perPageSelect').on('change', function () {
            perPage = parseInt(this.value, 10);
            currentPage = 1;
            render();
        });

        render();

        // ============================================================
        // ÇİFT KAYIT ÖNLEYİCİ (Buton kilidi + spinner)
        // ============================================================
        $('form.js-lock').on('submit', function () {
            var $btn = $(this).find('button[type="submit"]');
            if ($btn.data('locked')) { return false; } // Zaten gönderiliyor
            if ($btn.data('orig') === undefined) { $btn.data('orig', $btn.html()); }
            $btn.data('locked', true).prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> İşleniyor...');
        });

        // Modal iptal/kapatılırsa butonu tekrar aktif et
        $('.modal').on('hidden.bs.modal', function () {
            var $btn = $(this).find('button[type="submit"]');
            if ($btn.data('orig') !== undefined) {
                $btn.prop('disabled', false).data('locked', false).html($btn.data('orig'));
            }
        });

        @if (TempData["Hata"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'error',
                    title: 'HATA!',
                    text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Hata"].ToString()))',
                    confirmButtonColor: '#d33'
                });
            </text>
        }

        @if (TempData["Basarili"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Basarili"].ToString()))',
                    confirmButtonColor: '#059669'
                });
            </text>
        }
    });
</script>