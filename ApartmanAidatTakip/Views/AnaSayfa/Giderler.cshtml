<div class="modal fade" id="SabitOdeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white border-0" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                <h5 class="modal-title fw-bold"><i class="bi bi-credit-card me-2"></i>Sabit Gider Ödeme</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <form action="/AnaSayfa/SabitGiderOde" method="post" class="js-lock">
                <input type="hidden" name="id" id="ode_SabitGiderID" />
                <input type="hidden" name="SabitGiderID" id="ode_SabitGiderID2" />
                <div class="modal-body p-4">
                    <div id="ode_TekrarOdemeUyari" class="alert alert-info py-2 px-3 small mb-3 d-none">
                        <i class="bi bi-info-circle-fill me-1"></i><strong>Bilgi:</strong> Bu ay bu sabit gider için daha önce ödeme yapıldı. İkinci / ilave bir ödeme kaydı ekliyorsunuz.
                    </div>
                    <div class="p-3 mb-3 rounded-3 sabit-ode-summary-box">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge sabit-ode-kategori-badge" id="ode_GiderTuruBadge">Kategori</span>
                            <span class="small text-muted">Kayıtlı Sabit Tutar: <strong id="ode_SabitKayitliTutarText" class="sabit-ode-tutar-text">0,00 ₺</strong></span>
                        </div>
                        <h6 class="fw-bold mb-0 sabit-ode-baslik" id="ode_SabitBaslik">Sabit Gider</h6>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Bu Dönem Ödenecek Tutar <span class="text-danger">*</span></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text border-end-0">₺</span>
                            <input type="text"
                                   name="GiderTutar"
                                   id="ode_GiderTutar"
                                   class="form-control border-start-0 ps-0 fw-bold text-success money-input"
                                   required
                                   autocomplete="off">
                        </div>
                        <small class="text-muted d-block mt-1">
                            <i class="bi bi-info-circle me-1"></i>Fatura tutarı değiştiyse yeni tutarı giriniz; sabit gider tutarı da otomatik güncellenecektir.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Gider Açıklaması <span class="text-danger">*</span></label>
                        <textarea name="GiderAciklama" id="ode_GiderAciklama" class="form-control" rows="2" maxlength="500" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Ödeme Tarihi</label>
                        <input type="date" name="GiderTarih" id="ode_GiderTarih" class="form-control form-control-lg" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="SabitTutarGuncelle" value="true" id="ode_SabitTutarGuncelle" checked>
                        <input type="hidden" name="SabitTutarGuncelle" value="false" />
                        <label class="form-check-label small text-muted" for="ode_SabitTutarGuncelle">
                            Girilen tutarı sabit giderin varsayılan kayıtlı tutarı olarak da güncelle
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-link text-muted text-decoration-none" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-success px-4 rounded-pill">
                        <i class="bi bi-check2-circle me-1"></i>Ödemeyi Kaydet & Makbuz Aç
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="SabitGuncelleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Sabit Gider Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/AnaSayfa/SabitGiderGuncelle" method="post" class="js-lock">
                <input type="hidden" name="SabitGiderID" id="update_SabitGiderID" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Gider Türü</label>
                        <select name="GiderTuruID" id="update_SabitGiderTuruID" class="form-select form-select-lg" required>
                            @foreach (var item in ViewBag.GiderTuru)
                            {
                                <option value="@item.GiderTuruID">@item.GiderTuruAdi</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Açıklama</label>
                        <textarea name="GiderAciklama" id="update_SabitGiderAciklama" class="form-control" rows="2" maxlength="500" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Tutar</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text border-end-0">₺</span>
                            <input type="text"
                                   name="GiderTutar"
                                   id="update_SabitGiderTutar"
                                   class="form-control border-start-0 ps-0 fw-bold text-warning money-input"
                                   required
                                   autocomplete="off">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase d-flex justify-content-between align-items-center">
                            <span>Son Ödeme Günü (Vade)</span>
                            <small class="text-muted text-lowercase fw-normal">(opsiyonel: 1-31 arası)</small>
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text border-end-0"><i class="bi bi-calendar-event"></i></span>
                            <input type="number"
                                   name="SonOdemeGunu"
                                   id="update_SabitSonOdemeGunu"
                                   class="form-control border-start-0 ps-0"
                                   min="1" max="31"
                                   placeholder="Örn: 25 (Her ayın 25'i)">
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;">Faturanın veya ödemenin her ay yapılması gereken son gününü belirtir.</small>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-link text-muted text-decoration-none" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning px-4 rounded-pill">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function() {

        // 1. TOOLTIP AKTİVASYONU (Bootstrap)
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        // ============================================================
        // ÇİFT KAYIT ÖNLEYİCİ (Buton kilidi + spinner)
        // ============================================================
        $('form.js-lock').on('submit', function () {
            var $btn = $(this).find('button[type="submit"]');
            if ($btn.data('locked')) { return false; } // Zaten gönderiliyor
            if ($btn.data('orig') === undefined) { $btn.data('orig', $btn.html()); }
            $btn.data('locked', true).prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> İşleniyor...');
        });

        // Modal iptal/kapatılırsa butonu tekrar aktif et
        $('.modal').on('hidden.bs.modal', function () {
            var $btn = $(this).find('button[type="submit"]');
            if ($btn.data('orig') !== undefined) {
                $btn.prop('disabled', false).data('locked', false).html($btn.data('orig'));
            }
        });

        // ============================================================
        // 2. OTOMATİK PARA FORMATLAMA (1.000,50 ŞEKLİNDE)
        // ============================================================
        $('body').on('input', '.money-input', function() {
            var val = $(this).val();

            // Sadece rakam ve virgül kalacak şekilde temizle
            val = val.replace(/[^0-9,]/g, '');

            // Virgül var mı kontrol et
            if (val.indexOf(',') > -1) {
                var parts = val.split(',');

                // Tam kısım: Binlik ayracı (nokta) ekle
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".");

                // Kuruş kısım: Sadece ilk 2 basamağı al
                if (parts[1].length > 2) {
                    parts[1] = parts[1].substring(0, 2);
                }

                // Birleştir
                $(this).val(parts[0] + ',' + parts[1]);
            } else {
                // Virgül yoksa sadece binlik nokta ekle
                val = val.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                $(this).val(val);
            }
        });

        // ============================================================
        // 3. DÜZENLEME BUTONU İŞLEMLERİ
        // ============================================================
        $('.btn-duzenle').click(function() {
            var id = $(this).data('id');
            var turId = $(this).data('turid');
            var aciklama = $(this).data('aciklama');

            // Veri tabanından gelen string tutar (Örn: "1250,50")
            var tutar = $(this).data('tutar');

            // Modal Inputlarına Verileri Bas
            $('#update_GiderID').val(id);
            $('#update_GiderTuruID').val(turId);
            $('#update_GiderAciklama').val(aciklama);
            var sabitId = $(this).data('sabitid');
            $('#update_GiderSabitID').val(sabitId && sabitId > 0 ? sabitId : '');

            // Tutarı yaz ve otomatik formatlamayı tetikle
            $('#update_GiderTutar').val(tutar).trigger('input');

            // Modalı Aç
            var myModal = new bootstrap.Modal(document.getElementById('GuncelleModal'));
            myModal.show();
        });

        // ============================================================
                // ============================================================
        // 3.2 SABİT GİDER DÜZENLEME BUTONU
        // ============================================================
        $('body').on('click', '.btn-sabit-duzenle', function(e) {
            e.stopPropagation();
            $('#update_SabitGiderID').val($(this).data('id'));
            $('#update_SabitGiderTuruID').val($(this).data('turid'));
            $('#update_SabitGiderAciklama').val($(this).data('aciklama'));
            $('#update_SabitGiderTutar').val($(this).data('tutar')).trigger('input');
            var songun = $(this).data('songun');
            $('#update_SabitSonOdemeGunu').val(songun && songun > 0 ? songun : '');

            var m = new bootstrap.Modal(document.getElementById('SabitGuncelleModal'));
            m.show();
        });

        // ============================================================
                // Yeni Gider Ekle'de Sabit Gider seçilirse form alanlarını otomatik doldur
        $('#add_GiderSabitID').on('change', function() {
            var $opt = $(this).find('option:selected');
            var turId = $opt.data('turid');
            var aciklama = $opt.data('aciklama');
            var tutar = $opt.data('tutar');

            if ($(this).val()) {
                if (turId) {
                    $('#EkleModal select[name="GiderTuruID"]').val(turId);
                }
                if (aciklama) {
                    $('#EkleModal textarea[name="GiderAciklama"]').val(aciklama);
                }
                if (tutar) {
                    $('#EkleModal input[name="GiderTutar"]').val(tutar).trigger('input');
                }
            }
        });

        // 3.3 SABİT GİDER ÖDEME MODALINI AÇMA FONKSİYONU
        // ============================================================
        function openSabitOdeModal(id, aciklama, tutar, turAdi, odendi, odemeAdedi) {
            $('#ode_SabitGiderID').val(id);
            $('#ode_SabitGiderID2').val(id);
            $('#ode_SabitBaslik').text(aciklama);
            $('#ode_GiderAciklama').val(aciklama);
            $('#ode_GiderTuruBadge').text(turAdi || 'Genel');
            $('#ode_SabitKayitliTutarText').text(tutar + ' ₺');
            $('#ode_GiderTutar').val(tutar).trigger('input');

            // Eğer bu ay daha önce ödeme yapılmışsa uyarı göster
            if (odendi === true || odendi === 'true' || (odemeAdedi && parseInt(odemeAdedi) > 0)) {
                $('#ode_TekrarOdemeUyari').removeClass('d-none');
                $('#ode_SabitTutarGuncelle').prop('checked', false); // 2. ödemelerde genel tutarı bozmamak için varsayılan unchecked
            } else {
                $('#ode_TekrarOdemeUyari').addClass('d-none');
                $('#ode_SabitTutarGuncelle').prop('checked', true);
            }

            var m = new bootstrap.Modal(document.getElementById('SabitOdeModal'));
            m.show();
        }

        // Karta tıklandığında (içindeki butonlar/linkler hariç) ödeme modalını aç
        $('body').on('click', '.sabit-card', function(e) {
            if ($(e.target).closest('button, a, .btn, .btn-icon-soft').length > 0) {
                return;
            }
            var id = $(this).data('id');
            var aciklama = $(this).data('aciklama');
            var tutar = $(this).data('tutar');
            var turAdi = $(this).data('turadi');
            var odendi = $(this).data('odendi');
            var odemeAdedi = $(this).data('odeme-adedi');
            openSabitOdeModal(id, aciklama, tutar, turAdi, odendi, odemeAdedi);
        });

        // "Öde" veya "+" butonuna basıldığında ödeme modalını aç
        $('body').on('click', '.btn-sabit-ode-modal-trigger', function(e) {
            e.stopPropagation();
            var id = $(this).data('id');
            var aciklama = $(this).data('aciklama');
            var tutar = $(this).data('tutar');
            var turAdi = $(this).closest('.sabit-card').data('turadi') || 'Genel';
            var odendi = $(this).data('odendi') || $(this).closest('.sabit-card').data('odendi');
            var odemeAdedi = $(this).data('odeme-adedi') || $(this).closest('.sabit-card').data('odeme-adedi');
            openSabitOdeModal(id, aciklama, tutar, turAdi, odendi, odemeAdedi);
        });

        // ============================================================
        // 3.4 SABİT GİDER CANLI ARAMA VE FİLTRELEME
        // ============================================================
        function filterSabitGiderler() {
            var search = ($('#sabitGiderSearch').val() || '').toLowerCase().trim();
            var activeFilter = $('.sabit-filter-btn.active').data('filter') || 'all';

            $('.sabit-grid-col').each(function() {
                var $col = $(this);
                var keywords = ($col.data('keywords') || '').toString();
                var status = $col.data('status');
                var yaklasan = $col.data('yaklasan') === true || $col.data('yaklasan') === 'true';

                var matchesSearch = search === '' || keywords.indexOf(search) > -1;
                var matchesStatus = true;

                if (activeFilter === 'odendi') {
                    matchesStatus = (status === 'odendi');
                } else if (activeFilter === 'odenmedi') {
                    matchesStatus = (status === 'odenmedi');
                } else if (activeFilter === 'yaklasan') {
                    matchesStatus = yaklasan;
                }

                if (matchesSearch && matchesStatus) {
                    $col.show();
                } else {
                    $col.hide();
                }
            });
        }

        $('#sabitGiderSearch').on('input keyup', function() {
            filterSabitGiderler();
        });

        $('.sabit-filter-btn').on('click', function() {
            $('.sabit-filter-btn').removeClass('active');
            $(this).addClass('active');
            filterSabitGiderler();
        });

        // ============================================================
        // 3.1 SABİT GİDERDEN MAKBUZ OLUŞTURMA
        // ============================================================
        $('.btn-sabit-olustur').click(function() {
            var id = $(this).data('id');
            var aciklama = $(this).data('aciklama');

            Swal.fire({
                title: 'Gider Oluşturulsun mu?',
                html: "<b>" + $('<div>').text(aciklama).html() + "</b><br>bu dönem için gider olarak eklenecek ve makbuzu açılacak.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#20e3b2',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Evet, Oluştur',
                cancelButtonText: 'Vazgeç',
                customClass: {
                    confirmButton: 'btn btn-success px-4 rounded-pill',
                    cancelButton: 'btn btn-secondary px-4 rounded-pill ml-2'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    // Gideri oluştur + makbuz PDF'ini yeni sekmede aç
                    window.open('/AnaSayfa/SabitGiderOlustur/' + id, '_blank');
                    // Listenin güncellenmesi için sayfayı tazele
                    Swal.fire({
                        icon: 'success',
                        title: 'Gider Oluşturuldu',
                        text: 'Makbuz yeni sekmede açıldı.',
                        timer: 1800,
                        showConfirmButton: false
                    }).then(() => { window.location.reload(); });
                }
            });
        });

        // ============================================================
        // 4. SWEETALERT BİLDİRİMLERİ (SERVER TARAFLI)
        // ============================================================
        @if (TempData["Hata"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Hata!',
                    text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Hata"].ToString()))',
                    confirmButtonColor: '#d33',
                    background: '#fff',
                    color: '#333'
                });
            </text>
        }

        @if (TempData["YeniGiderMakbuzID"] != null)
        {
            <text>
                // Yeni eklenen giderin makbuzunu yeni sekmede aç
                window.open('/AnaSayfa/GiderMakbuz?GiderID=@TempData["YeniGiderMakbuzID"]', '_blank');
            </text>
        }

        @if (TempData["Basarili"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'İşlem Başarılı!',
                    text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Basarili"].ToString()))',
                    confirmButtonColor: '#4158D0',
                    timer: 2000,
                    showConfirmButton: false
                });
            </text>
        }
    });

    // ============================================================
    // 5. SİLME ONAYI FONKSİYONU
    // ============================================================
    function confirmDeleteExpense(event, id) {
        event.preventDefault(); // Linke gitmeyi durdur

        Swal.fire({
            title: 'Silmek İstiyor musunuz?',
            text: "Bu gider kaydı kalıcı olarak silinecek ve geri alınamaz!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, Sil',
            cancelButtonText: 'Vazgeç',
            background: '#fff',
            customClass: {
                confirmButton: 'btn btn-danger px-4 rounded-pill',
                cancelButton: 'btn btn-secondary px-4 rounded-pill ml-2'
            },
            buttonsStyling: false
        }).then((result) => {
            if (result.isConfirmed) {
                // Onay verilirse silme linkine git
                window.location.href = '/AnaSayfa/GiderSil/' + id;
            }
        })
    }

    // ============================================================
    // 6. SABİT GİDER SİLME ONAYI
    // ============================================================
    function confirmDeleteSabit(event, id) {
        event.preventDefault();

        Swal.fire({
            title: 'Sabit Gider Silinsin mi?',
            text: "Bu sabit gider şablonu listeden kaldırılacak. (Daha önce oluşturulmuş gider kayıtları etkilenmez.)",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, Sil',
            cancelButtonText: 'Vazgeç',
            customClass: {
                confirmButton: 'btn btn-danger px-4 rounded-pill',
                cancelButton: 'btn btn-secondary px-4 rounded-pill ml-2'
            },
            buttonsStyling: false
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/AnaSayfa/SabitGiderSil/' + id;
            }
        })
    }
</script>