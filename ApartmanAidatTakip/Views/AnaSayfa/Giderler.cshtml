﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿@{
    ViewBag.Title = "Gider Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string tl = "₺";
}

<style>
    /* Genel Kart ve Gölgeler */
    .card-legendary {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .card-header-legendary {
        background: linear-gradient(135deg, #4158D0 0%, #C850C0 46%, #FFCC70 100%);
        color: white;
        padding: 20px 25px;
        border-bottom: none;
    }

    /* Tablo Tasarımı */
    .table-modern thead th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        border-bottom: 2px solid #e9ecef;
        padding: 15px;
    }

    .table-modern tbody td {
        vertical-align: middle;
        padding: 15px;
        border-bottom: 1px solid #f1f1f1;
        transition: background-color 0.3s;
    }

    .table-modern tbody tr:hover {
        background-color: #f8fbff;
        transform: scale(1.005);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        z-index: 2;
        position: relative;
    }

    /* Tarih Kutusu Tasarımı */
    .date-box {
        background: #eef2f7;
        color: #5d6e82;
        border-radius: 10px;
        padding: 5px 10px;
        text-align: center;
        min-width: 80px;
        display: inline-block;
        font-weight: bold;
        border: 1px solid #dee2e6;
    }

        .date-box span {
            display: block;
        }

    .date-day {
        font-size: 1.2rem;
        color: #2c3e50;
        line-height: 1;
    }

    .date-year {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Tutar Tasarımı */
    .amount-text {
        font-family: 'Consolas', 'Monaco', monospace; /* Para birimi için monospace */
        font-size: 1.1rem;
        font-weight: 700;
        color: #2ecc71;
        letter-spacing: -0.5px;
    }

    /* Efsanevi Yuvarlak Butonlar (Soft UI) */
    .btn-icon-soft {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        margin: 0 3px;
    }

        .btn-icon-soft i {
            font-size: 1.1rem;
        }

    .btn-soft-primary {
        background-color: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
    }

        .btn-soft-primary:hover {
            background-color: #0d6efd;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        }

    .btn-soft-warning {
        background-color: rgba(255, 193, 7, 0.1);
        color: #d68910;
    }

        .btn-soft-warning:hover {
            background-color: #ffc107;
            color: black;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
        }

    .btn-soft-danger {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }

        .btn-soft-danger:hover {
            background-color: #dc3545;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
        }

    .btn-soft-dark {
        background-color: rgba(33, 37, 41, 0.1);
        color: #212529;
    }

        .btn-soft-dark:hover {
            background-color: #212529;
            color: white;
            transform: translateY(-3px);
        }

    /* Badge İyileştirmesi */
    .badge-soft {
        padding: 8px 12px;
        border-radius: 30px;
        font-weight: 500;
        font-size: 0.85rem;
    }

        /* Sabit Gider Kart Grid & Tasarım */
    .sabit-card {
        cursor: pointer;
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 14px;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        background: #ffffff;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .sabit-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.08);
    }
    .sabit-card.odendi {
        border-color: rgba(32, 227, 178, 0.45);
        background: linear-gradient(180deg, #ffffff 0%, rgba(32, 227, 178, 0.05) 100%);
    }
    .sabit-card.odenmedi {
        border-color: rgba(220, 53, 69, 0.2);
    }
    .sabit-card.gecikti {
        border-color: rgba(220, 53, 69, 0.45);
        background: linear-gradient(180deg, #ffffff 0%, rgba(220, 53, 69, 0.03) 100%);
    }
    .sabit-card.yaklasti {
        border-color: rgba(255, 193, 7, 0.45);
        background: linear-gradient(180deg, #ffffff 0%, rgba(255, 193, 7, 0.03) 100%);
    }

    .sabit-status-badge {
        font-size: 0.72rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 20px;
        letter-spacing: 0.3px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .sabit-status-odendi {
        background-color: rgba(25, 135, 84, 0.12);
        color: #198754;
    }
    .sabit-status-odenmedi {
        background-color: rgba(220, 53, 69, 0.12);
        color: #dc3545;
    }

    .sabit-vade-badge {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 6px;
    }
    .vade-gecikti {
        background-color: #fee2e2;
        color: #991b1b;
    }
    .vade-bugun {
        background-color: #ffedd5;
        color: #9a3412;
        font-weight: 700;
    }
    .vade-yaklasti {
        background-color: #fef3c7;
        color: #92400e;
    }
    .vade-bekliyor {
        background-color: #f1f5f9;
        color: #475569;
    }
    .vade-odendi {
        background-color: #dcfce7;
        color: #166534;
    }

    .sabit-category-pill {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 6px;
        background-color: #e0f2fe;
        color: #0369a1;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .sabit-title {
        font-size: 0.92rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.35;
        min-height: 2.7em;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .sabit-amount {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.5px;
    }
    .sabit-amount-sub {
        font-size: 0.72rem;
        color: #198754;
        font-weight: 600;
    }
    .sabit-filter-btn {
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 5px 14px;
        border: 1px solid rgba(0,0,0,0.08);
        background: #ffffff;
        color: #64748b;
        transition: all 0.2s ease;
    }
    .sabit-filter-btn:hover {
        background: #f8fafc;
        color: #0f172a;
    }
    .sabit-filter-btn.active {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
    }
    .sabit-search-input {
        border-radius: 20px;
        font-size: 0.85rem;
        padding: 6px 14px 6px 36px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
    }
    .sabit-search-wrap {
        position: relative;
    }
    .sabit-search-wrap i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 0.9rem;
    }
    .btn-sabit-action {
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 5px 10px;
    }

    /* Sabit Gider Ödeme Modal Kutusu (Light Mode) */
    .sabit-ode-summary-box {
        background-color: #ecfdf5;
        border: 1px solid #a7f3d0;
        transition: all 0.2s ease;
    }
    .sabit-ode-baslik {
        color: #064e3b;
    }
    .sabit-ode-tutar-text {
        color: #047857;
    }
    .sabit-ode-kategori-badge {
        background-color: #10b981;
        color: #ffffff;
    }

    /* ============================================================
       DARK MODE UYUMU (CLAUDE.md standardı: --dm-surface, --dm-text)
       ============================================================ */
    html.dark-mode .sabit-card {
        background: var(--dm-surface, #1b1f2a) !important;
        border-color: var(--dm-border, #2c3242) !important;
    }
    html.dark-mode .sabit-card.odendi {
        border-color: rgba(32, 227, 178, 0.35) !important;
        background: linear-gradient(180deg, var(--dm-surface, #1b1f2a) 0%, rgba(32, 227, 178, 0.06) 100%) !important;
    }
    html.dark-mode .sabit-card.odenmedi {
        border-color: rgba(220, 53, 69, 0.25) !important;
    }
    html.dark-mode .sabit-card.gecikti {
        border-color: rgba(220, 53, 69, 0.45) !important;
        background: linear-gradient(180deg, var(--dm-surface, #1b1f2a) 0%, rgba(220, 53, 69, 0.08) 100%) !important;
    }
    html.dark-mode .sabit-card.yaklasti {
        border-color: rgba(245, 158, 11, 0.45) !important;
        background: linear-gradient(180deg, var(--dm-surface, #1b1f2a) 0%, rgba(245, 158, 11, 0.08) 100%) !important;
    }
    html.dark-mode .sabit-title {
        color: var(--dm-text, #e4e6eb) !important;
    }
    html.dark-mode .sabit-amount {
        color: var(--dm-text, #e4e6eb) !important;
    }
    html.dark-mode .sabit-amount-sub {
        color: #34d399 !important;
    }

    /* Rozetler ve Vade Etiketleri */
    html.dark-mode .sabit-category-pill {
        background-color: rgba(56, 189, 248, 0.15) !important;
        color: #38bdf8 !important;
    }
    html.dark-mode .sabit-status-odendi {
        background-color: rgba(16, 185, 129, 0.18) !important;
        color: #34d399 !important;
    }
    html.dark-mode .sabit-status-odenmedi {
        background-color: rgba(220, 53, 69, 0.18) !important;
        color: #f87171 !important;
    }
    html.dark-mode .vade-gecikti {
        background-color: rgba(220, 53, 69, 0.2) !important;
        color: #f87171 !important;
        border: 1px solid rgba(220, 53, 69, 0.3) !important;
    }
    html.dark-mode .vade-bugun {
        background-color: rgba(249, 115, 22, 0.2) !important;
        color: #fb923c !important;
        border: 1px solid rgba(249, 115, 22, 0.3) !important;
    }
    html.dark-mode .vade-yaklasti {
        background-color: rgba(245, 158, 11, 0.2) !important;
        color: #fbbf24 !important;
        border: 1px solid rgba(245, 158, 11, 0.3) !important;
    }
    html.dark-mode .vade-bekliyor {
        background-color: var(--dm-surface-2, #232838) !important;
        color: var(--dm-muted, #9aa3b2) !important;
        border: 1px solid var(--dm-border, #2c3242) !important;
    }
    html.dark-mode .vade-odendi {
        background-color: rgba(16, 185, 129, 0.18) !important;
        color: #34d399 !important;
        border: 1px solid rgba(16, 185, 129, 0.3) !important;
    }

    /* Filtre ve Arama */
    html.dark-mode .sabit-filter-btn {
        background: var(--dm-surface, #1b1f2a) !important;
        color: var(--dm-muted, #9aa3b2) !important;
        border-color: var(--dm-border, #2c3242) !important;
    }
    html.dark-mode .sabit-filter-btn:hover {
        background: var(--dm-surface-2, #232838) !important;
        color: var(--dm-text, #e4e6eb) !important;
    }
    html.dark-mode .sabit-filter-btn.active {
        background: var(--dm-primary, #6d8bff) !important;
        color: #ffffff !important;
        border-color: var(--dm-primary, #6d8bff) !important;
    }
    html.dark-mode .sabit-search-input {
        background: var(--dm-surface-2, #232838) !important;
        border-color: var(--dm-border, #2c3242) !important;
        color: var(--dm-text, #e4e6eb) !important;
    }

    /* Sabit Gider Ödeme Modalı (Dark Mode) */
    html.dark-mode .sabit-ode-summary-box {
        background-color: var(--dm-surface-2, #232838) !important;
        border-color: var(--dm-border, #2c3242) !important;
    }
    html.dark-mode .sabit-ode-baslik {
        color: var(--dm-text, #e4e6eb) !important;
    }
    html.dark-mode .sabit-ode-tutar-text {
        color: #34d399 !important;
    }
    html.dark-mode .sabit-ode-kategori-badge {
        background-color: rgba(16, 185, 129, 0.25) !important;
        color: #34d399 !important;
        border: 1px solid rgba(16, 185, 129, 0.4) !important;
    }
    html.dark-mode #ode_TekrarOdemeUyari {
        background-color: rgba(13, 110, 253, 0.15) !important;
        color: #93c5fd !important;
        border-color: rgba(13, 110, 253, 0.3) !important;
    }
    html.dark-mode .modal-content {
        background-color: var(--dm-surface, #1b1f2a) !important;
        border-color: var(--dm-border, #2c3242) !important;
        color: var(--dm-text, #e4e6eb) !important;
    }
    html.dark-mode .modal-footer {
        background-color: var(--dm-surface, #1b1f2a) !important;
        border-top: 1px solid var(--dm-border, #2c3242) !important;
    }
    html.dark-mode .input-group-text {
        background-color: var(--dm-surface-2, #232838) !important;
        border-color: var(--dm-border, #2c3242) !important;
        color: var(--dm-muted, #9aa3b2) !important;
    }

    /* --- DATATABLE ÖZELLEŞTİRME (LEGENDARY UYUMLU) --- */

    /* Arama ve Sayı Seçme Kutuları */
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 5px 15px;
        outline: none;
        transition: all 0.3s;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }

        .dataTables_wrapper .dataTables_filter input:focus,
        .dataTables_wrapper .dataTables_length select:focus {
            border-color: #4158D0;
            box-shadow: 0 0 0 3px rgba(65, 88, 208, 0.1);
        }

    /* Tablo Bilgi Yazısı (Sol alt) */
    .dataTables_wrapper .dataTables_info {
        color: #6c757d !important;
        font-size: 0.85rem;
        margin-top: 10px;
        padding-left: 15px;
    }

    /* Sayfalama (Pagination) Alanı */
    .dataTables_wrapper .dataTables_paginate {
        margin-top: 10px;
        padding-right: 15px;
    }

        /* Sayfalama Butonları */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border: none !important;
            background: transparent !important;
            color: #6c757d !important;
            border-radius: 50% !important;
            width: 35px;
            height: 35px;
            line-height: 35px;
            padding: 0 !important;
            text-align: center;
            margin: 0 2px;
            font-weight: 600;
            transition: all 0.2s;
        }

            /* Aktif Sayfa Butonu */
            .dataTables_wrapper .dataTables_paginate .paginate_button.current,
            .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                background: linear-gradient(135deg, #4158D0 0%, #C850C0 100%) !important;
                color: white !important;
                box-shadow: 0 4px 10px rgba(65, 88, 208, 0.3);
                transform: translateY(-2px);
            }

            /* Hover Durumu */
            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background: #e9ecef !important;
                color: #4158D0 !important;
                transform: translateY(-2px);
            }

            /* Previous/Next Yazılarını Gizle, Sadece Ok Kalsın (Opsiyonel) */
            .dataTables_wrapper .dataTables_paginate .paginate_button.previous,
            .dataTables_wrapper .dataTables_paginate .paginate_button.next {
                border-radius: 10px !important;
                width: auto;
                padding: 0 10px !important;
            }

    /* Tablo başlıklarındaki sıralama oklarını düzenle */
    table.dataTable thead .sorting:before, table.dataTable thead .sorting_asc:before, table.dataTable thead .sorting_desc:before,
    table.dataTable thead .sorting:after, table.dataTable thead .sorting_asc:after, table.dataTable thead .sorting_desc:after {
        opacity: 0.5;
        bottom: 15px !important;
    }
</style>

<div class="pagetitle mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold text-dark">Gider Yönetimi</h1>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/AnaSayfa/Index">Ana Sayfa</a></li>
                <li class="breadcrumb-item active">Giderler</li>
            </ol>
        </nav>
    </div>

    <div>
        @if (ViewBag.DonemSorgu == true)
        {
            <button type="button" class="btn btn-dark rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#EkleModal">
                <i class="bi bi-plus-lg me-2"></i>Yeni Gider Ekle
            </button>
        }
        else
        {
            <div class="d-flex flex-column align-items-end">
                <button type="button" class="btn btn-secondary rounded-pill px-4" disabled>
                    <i class="bi bi-lock-fill me-2"></i>Dönem Kapalı
                </button>
                <small class="text-danger fw-bold mt-1" style="font-size: 0.75rem;">
                    <i class="bi bi-exclamation-circle"></i> @DateTime.Now.ToString("MMMM") dönemi başlatılmalı
                </small>
            </div>
        }
    </div>
</div>

<div class="card card-legendary mb-5">
    <div class="card-header-legendary d-flex justify-content-between align-items-center">
        <h5 class="m-0 fw-bold"><i class="bi bi-wallet2 me-2"></i>Gider Hareketleri</h5>
        <span class="badge bg-white text-dark bg-opacity-75 rounded-pill px-3">
            Toplam: @(ViewBag.Giderler.Count) Kayıt
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0 datatable">
                <thead>
                    <tr>
                        <th class="ps-4">TARİH</th>
                        <th>GİDER NO</th>
                        <th>KATEGORİ</th>
                        <th>AÇIKLAMA</th>
                        <th class="text-end">TUTAR</th>
                        <th class="text-center pe-4">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.Giderler)
                    {
                        <tr>
                            <td class="ps-4" style="width: 120px;">
                                <div class="date-box">
                                    <span class="date-day">@item.GiderTarih.Day</span>
                                    <span class="date-year">@item.GiderTarih.ToString("MMM yyyy")</span>
                                </div>
                            </td>

                            <td class="fw-bold text-muted">#@item.GiderNo</td>

                            <td>
                                <span class="badge badge-soft" style="background-color: #e0f2fe; color: #0369a1;">
                                    <i class="bi bi-tag-fill me-1"></i> @item.GiderTuruAdi
                                </span>
                            </td>

                            <td style="max-width: 300px;">
                                <div class="text-dark fw-bold">
                                    @(item.GiderAciklama.Length > 30 ? item.GiderAciklama.Substring(0, 30) + "..." : item.GiderAciklama)
                                </div>
                                @if (item.GiderAciklama.Length > 30)
                                {
                                    <small class="text-muted" style="font-size: 0.75rem;">Tamamını görmek için düzenleye basınız</small>
                                }
                            </td>

                            <td class="text-end">
                                <span class="amount-text">@item.GiderTutar.ToString("N2")</span>
                                <span class="text-muted small">@tl</span>
                            </td>

                            <td class="text-center pe-4">
                                <a href="/AnaSayfa/GiderMakbuz?GiderID=@item.GiderID"
                                   target="_blank"
                                   class="btn-icon-soft btn-soft-dark"
                                   title="Yazdır" data-bs-toggle="tooltip">
                                    <i class="bi bi-printer"></i>
                                </a>

                                <button type="button"
                                        class="btn-icon-soft btn-soft-warning btn-duzenle"
                                        title="Düzenle" data-bs-toggle="tooltip"
                                        data-id="@item.GiderID"
                                        data-turid="@item.GiderTuruID"
                                        data-aciklama="@item.GiderAciklama"
                                        data-tutar="@item.GiderTutar.ToString("F2")"
                                        data-sabitid="@(ViewBag.GiderSabitMap != null && ((System.Collections.Generic.Dictionary<int, int>)ViewBag.GiderSabitMap).ContainsKey(item.GiderID) ? ((System.Collections.Generic.Dictionary<int, int>)ViewBag.GiderSabitMap)[item.GiderID] : 0)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button type="button"
                                        class="btn-icon-soft btn-soft-danger"
                                        onclick="confirmDeleteExpense(event, @item.GiderID)"
                                        title="Sil" data-bs-toggle="tooltip">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (ViewBag.Giderler.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                                    Bu dönem için henüz bir gider kaydı bulunmuyor.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card card-legendary mb-5">
    <div class="card-header-legendary d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: linear-gradient(135deg, #0cebeb 0%, #20e3b2 50%, #29ffc6 100%);">
        <div class="d-flex align-items-center gap-2">
            <h5 class="m-0 fw-bold text-dark"><i class="bi bi-arrow-repeat me-2"></i>Sabit (Tekrar Eden) Giderler</h5>
            <span class="badge bg-dark text-white rounded-pill px-2">@(ViewBag.SabitGiderler != null ? ViewBag.SabitGiderler.Count : 0)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-dark btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#SabitEkleModal">
                <i class="bi bi-plus-lg me-1"></i>Yeni Sabit Gider
            </button>
        </div>
    </div>
    <div class="card-body p-3 p-md-4">
        <!-- Canlı Arama ve Durum Filtreleme Çubuğu -->
        <div class="row g-2 align-items-center mb-3">
            <div class="col-12 col-md-5">
                <div class="sabit-search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text" id="sabitGiderSearch" class="form-control sabit-search-input" placeholder="Sabit giderlerde ara (Açıklama, kategori)..." autocomplete="off" />
                </div>
            </div>
            <div class="col-12 col-md-7 d-flex flex-wrap justify-content-md-end gap-1">
                <button type="button" class="sabit-filter-btn active" data-filter="all">Tümü (@(ViewBag.SabitGiderler != null ? ViewBag.SabitGiderler.Count : 0))</button>
                <button type="button" class="sabit-filter-btn text-success" data-filter="odendi"><i class="bi bi-check2-circle me-1"></i>Ödenenler (@(ViewBag.SabitGiderler != null ? ((System.Collections.Generic.IEnumerable<ApartmanAidatTakip.Models.SabitGiderListe>)ViewBag.SabitGiderler).Count(x => x.OdendiMi) : 0))</button>
                <button type="button" class="sabit-filter-btn text-danger" data-filter="odenmedi"><i class="bi bi-clock me-1"></i>Ödenmeyenler (@(ViewBag.SabitGiderler != null ? ((System.Collections.Generic.IEnumerable<ApartmanAidatTakip.Models.SabitGiderListe>)ViewBag.SabitGiderler).Count(x => !x.OdendiMi) : 0))</button>
                <button type="button" class="sabit-filter-btn text-warning" data-filter="yaklasan"><i class="bi bi-exclamation-triangle me-1"></i>Yaklaşan/Geciken (@(ViewBag.SabitGiderler != null ? ((System.Collections.Generic.IEnumerable<ApartmanAidatTakip.Models.SabitGiderListe>)ViewBag.SabitGiderler).Count(x => !x.OdendiMi && (x.DurumKodu == "gecikti" || x.DurumKodu == "bugun" || x.DurumKodu == "yaklasti")) : 0))</button>
            </div>
        </div>

        <!-- 1 Satırda 5 Kart (Responsive Grid) -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3" id="sabitGiderGrid">
            @if (ViewBag.SabitGiderler != null)
            {
                foreach (ApartmanAidatTakip.Models.SabitGiderListe item in ViewBag.SabitGiderler)
                {
                    string statusCardClass = item.OdendiMi ? "odendi" : (item.DurumKodu == "gecikti" ? "gecikti" : (item.DurumKodu == "yaklasti" || item.DurumKodu == "bugun" ? "yaklasti" : "odenmedi"));
                    string searchKeywords = ((item.GiderAciklama ?? "") + " " + (item.GiderTuruAdi ?? "")).ToLower(new System.Globalization.CultureInfo("tr-TR"));
                    string filterTag = item.OdendiMi ? "odendi" : "odenmedi";
                    bool isYaklasan = !item.OdendiMi && (item.DurumKodu == "gecikti" || item.DurumKodu == "bugun" || item.DurumKodu == "yaklasti");

                    <div class="col sabit-grid-col" data-keywords="@searchKeywords" data-status="@filterTag" data-yaklasan="@(isYaklasan ? "true" : "false")">
                        <div class="sabit-card @statusCardClass p-3"
                             role="button"
                             data-id="@item.SabitGiderID"
                             data-turid="@item.GiderTuruID"
                             data-turadi="@(string.IsNullOrEmpty(item.GiderTuruAdi) ? "Genel" : item.GiderTuruAdi)"
                             data-aciklama="@item.GiderAciklama"
                             data-tutar="@(((decimal?)item.GiderTutar ?? 0).ToString("F2"))"
                             data-songun="@(item.SonOdemeGunu ?? 0)"
                             data-odendi="@(item.OdendiMi ? "true" : "false")"
                             data-odeme-adedi="@item.OdemeAdedi"
                             title="Tutarını güncelleyip ödemek için tıklayın">
                            <!-- Kart Üst: Kategori ve Ödendi/Ödenmedi Rozeti -->
                            <div class="d-flex justify-content-between align-items-center mb-2 gap-1">
                                <span class="sabit-category-pill" title="@item.GiderTuruAdi">
                                    <i class="bi bi-tag-fill me-1"></i>@(string.IsNullOrEmpty(item.GiderTuruAdi) ? "Genel" : item.GiderTuruAdi)
                                </span>
                                @if (item.OdendiMi)
                                {
                                    <span class="sabit-status-badge sabit-status-odendi" title="Bu ay ödendi@(item.OdemeAdedi > 1 ? " (" + item.OdemeAdedi + " kez)" : "")">
                                        <i class="bi bi-check-circle-fill"></i> Ödendi@(item.OdemeAdedi > 1 ? " (" + item.OdemeAdedi + ")" : "")
                                    </span>
                                }
                                else
                                {
                                    <span class="sabit-status-badge sabit-status-odenmedi" title="Bu ay henüz ödenmedi">
                                        <i class="bi bi-clock-fill"></i> Ödenmedi
                                    </span>
                                }
                            </div>

                            <!-- Sabit Gider Açıklaması -->
                            <div class="sabit-title mb-2" title="@item.GiderAciklama">
                                @item.GiderAciklama
                            </div>

                            <!-- Tutar Bilgisi -->
                            <div class="mb-2">
                                <div class="sabit-amount">
                                    @(((decimal?)item.GiderTutar ?? 0).ToString("N2")) <span class="fs-6 fw-normal text-muted">@tl</span>
                                </div>
                                @if (item.OdendiMi && item.OdenenTutar.HasValue)
                                {
                                    <div class="sabit-amount-sub">
                                        <i class="bi bi-check2-all me-1"></i>Toplam Ödenen: @item.OdenenTutar.Value.ToString("N2") @tl
                                        @if (item.OdemeAdedi > 1)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.65rem;">@item.OdemeAdedi işlem</span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Vade / Son Ödeme Tarihi Rozeti -->
                            <div class="mb-3">
                                @if (item.OdendiMi)
                                {
                                    <span class="sabit-vade-badge vade-odendi">
                                        <i class="bi bi-calendar-check me-1"></i>@(item.OdemeTarihi.HasValue ? item.OdemeTarihi.Value.ToString("dd.MM.yyyy") : "") Ödendi
                                    </span>
                                }
                                else if (item.DurumKodu == "gecikti")
                                {
                                    <span class="sabit-vade-badge vade-gecikti" title="Son Ödeme: @(item.SonOdemeTarihi != null ? item.SonOdemeTarihi.Value.ToString("dd MMMM") : "")">
                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>@item.DurumMesaji
                                    </span>
                                }
                                else if (item.DurumKodu == "bugun")
                                {
                                    <span class="sabit-vade-badge vade-bugun" title="Son Ödeme Tarihi">
                                        <i class="bi bi-alarm-fill me-1"></i>Bugün Son Gün!
                                    </span>
                                }
                                else if (item.DurumKodu == "yaklasti")
                                {
                                    <span class="sabit-vade-badge vade-yaklasti" title="Son Ödeme: @(item.SonOdemeTarihi != null ? item.SonOdemeTarihi.Value.ToString("dd MMMM") : "")">
                                        <i class="bi bi-hourglass-split me-1"></i>@item.DurumMesaji
                                    </span>
                                }
                                else
                                {
                                    <span class="sabit-vade-badge vade-bekliyor" title="Son Ödeme: @(item.SonOdemeTarihi != null ? item.SonOdemeTarihi.Value.ToString("dd MMMM") : "")">
                                        <i class="bi bi-calendar-event me-1"></i>Son: @(item.SonOdemeTarihi != null ? item.SonOdemeTarihi.Value.ToString("dd MMMM") : "")
                                    </span>
                                }
                            </div>

                            <!-- Alt Aksiyon Butonları -->
                            <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between gap-1">
                                @if (item.OdendiMi)
                                {
                                    <a href="/AnaSayfa/GiderMakbuz?GiderID=@item.OdenenGiderID"
                                       target="_blank"
                                       class="btn btn-outline-success btn-sabit-action flex-grow-1 text-center"
                                       title="Son Makbuzu Görüntüle">
                                        <i class="bi bi-receipt me-1"></i>Makbuz
                                    </a>
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sabit-action btn-sabit-ode-modal-trigger px-2"
                                            title="Bu ay için 2. kez / ilave ödeme kaydı ekle"
                                            data-id="@item.SabitGiderID"
                                            data-turid="@item.GiderTuruID"
                                            data-aciklama="@item.GiderAciklama"
                                            data-tutar="@(((decimal?)item.GiderTutar ?? 0).ToString("F2"))"
                                            data-songun="@(item.SonOdemeGunu ?? 0)"
                                            data-odendi="@(item.OdendiMi ? "true" : "false")"
                                            data-odeme-adedi="@item.OdemeAdedi">
                                        <i class="bi bi-plus-lg me-1"></i>+ Öde
                                    </button>
                                }
                                else
                                {
                                    if (ViewBag.DonemSorgu == true)
                                    {
                                        <button type="button"
                                                class="btn btn-primary btn-sabit-action btn-sabit-ode-modal-trigger flex-grow-1"
                                                title="Bu sabit gideri öde ve gider kaydı oluştur"
                                                data-id="@item.SabitGiderID"
                                                data-turid="@item.GiderTuruID"
                                                data-aciklama="@item.GiderAciklama"
                                                data-tutar="@(((decimal?)item.GiderTutar ?? 0).ToString("F2"))"
                                                data-songun="@(item.SonOdemeGunu ?? 0)">
                                            <i class="bi bi-credit-card me-1"></i>Öde
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-sabit-action flex-grow-1" disabled title="Dönem kapalı">
                                            <i class="bi bi-lock-fill me-1"></i>Kapalı
                                        </button>
                                    }
                                }

                                <button type="button"
                                        class="btn-icon-soft btn-soft-warning btn-sabit-duzenle"
                                        title="Düzenle" data-bs-toggle="tooltip"
                                        data-id="@item.SabitGiderID"
                                        data-turid="@item.GiderTuruID"
                                        data-aciklama="@item.GiderAciklama"
                                        data-tutar="@(((decimal?)item.GiderTutar ?? 0).ToString("F2"))"
                                        data-songun="@(item.SonOdemeGunu ?? 0)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button type="button"
                                        class="btn-icon-soft btn-soft-danger"
                                        onclick="confirmDeleteSabit(event, @item.SabitGiderID)"
                                        title="Sabit gideri sil" data-bs-toggle="tooltip">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @if (ViewBag.SabitGiderler == null || ViewBag.SabitGiderler.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-arrow-repeat fs-1 d-block mb-3 opacity-25"></i>
                <h6 class="fw-bold text-dark">Henüz Sabit Gider Tanımlanmamış</h6>
                <p class="text-muted small">Her ay tekrar eden fatura, aidat veya personel giderlerinizi "Yeni Sabit Gider" butonuyla ekleyin.</p>
            </div>
        }
    </div>
</div>

<div class="accordion mb-5 shadow-sm rounded-3 overflow-hidden" id="accordionDeleted">
    <div class="accordion-item border-0">
        <h2 class="accordion-header" id="headingDeleted">
            <button class="accordion-button collapsed bg-light text-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDeleted" aria-expanded="false" aria-controls="collapseDeleted">
                <i class="bi bi-clock-history me-2"></i> Silinen Gider Geçmişi
            </button>
        </h2>
        <div id="collapseDeleted" class="accordion-collapse collapse" aria-labelledby="headingDeleted" data-bs-parent="#accordionDeleted">
            <div class="accordion-body p-0">
                <table class="table table-sm table-hover mb-0 text-muted" style="font-size: 0.9rem;">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">TARİH</th>
                            <th>NO</th>
                            <th>TÜR</th>
                            <th>AÇIKLAMA</th>
                            <th class="text-end pe-4">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.SilinenGiderler)
                        {
                            <tr>
                                <td class="ps-4">@item.GiderTarih.ToString("dd.MM.yyyy")</td>
                                <td>@item.GiderNo</td>
                                <td>@item.GiderTuruAdi</td>
                                <td>@item.GiderAciklama</td>
                                <td class="text-end pe-4 text-decoration-line-through text-danger">@item.GiderTutar.ToString("N2") @tl</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="EkleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni Gider Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/AnaSayfa/GiderEkle" method="post" class="js-lock">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase d-flex justify-content-between align-items-center">
                            <span>Sabit Gider İle Eşleştir</span>
                            <small class="text-muted text-lowercase fw-normal">(opsiyonel)</small>
                        </label>
                        <select name="SabitGiderID" id="add_GiderSabitID" class="form-select form-select-lg">
                            <option value="">-- Sabit Gider Seçilmedi (Normal Gider) --</option>
                            @if (ViewBag.SabitGiderler != null)
                            {
                                foreach (ApartmanAidatTakip.Models.SabitGiderListe s in ViewBag.SabitGiderler)
                                {
                                    <option value="@s.SabitGiderID"
                                            data-tutar="@(((decimal?)s.GiderTutar ?? 0).ToString("F2"))"
                                            data-turid="@s.GiderTuruID"
                                            data-aciklama="@s.GiderAciklama">
                                        @s.GiderAciklama (@(((decimal?)s.GiderTutar ?? 0).ToString("N2")) ₺) - @(s.OdendiMi ? "Bu Ay Ödendi" : "Ödenmedi")
                                    </option>
                                }
                            }
                        </select>
                        <small class="text-muted" style="font-size: 0.75rem;">Sabit gider seçerseniz tür, açıklama ve tutar otomatik dolar; bu gider sabit gideri "ÖDENDİ" yapar.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Gider Türü</label>
                        <select name="GiderTuruID" class="form-select form-select-lg" required>
                            @foreach (var item in ViewBag.GiderTuru)
                            {
                                <option value="@item.GiderTuruID">@item.GiderTuruAdi</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Açıklama</label>
                        <textarea name="GiderAciklama" class="form-control" rows="2" maxlength="500" required placeholder="Detay giriniz..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Tutar</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text border-end-0">₺</span>
                            <input type="text"
                                   name="GiderTutar"
                                   class="form-control border-start-0 ps-0 fw-bold text-primary money-input"
                                   placeholder="0,00"
                                   required
                                   autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-link text-muted text-decoration-none" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

