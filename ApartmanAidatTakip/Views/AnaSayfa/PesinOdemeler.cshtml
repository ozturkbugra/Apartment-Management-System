@{
    ViewBag.Title = "Peşin Ödemeler";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ayAdlari = new[] { "", "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
    int simdikiAy = DateTime.Now.Month;
    int simdikiYil = DateTime.Now.Year;
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-body: #f0f2f5;
        --card-shadow: 0 10px 30px rgba(0,0,0,0.05);
        --success-grad: linear-gradient(135deg, #059669 0%, #34d399 100%);
        --primary-soft: #e0e7ff;
        --primary-text: #4f46e5;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--bg-body);
        color: #344767;
    }

    /* Üst Alan */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        background: #fff;
        padding: 20px 25px;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
    }

    .btn-add {
        background: var(--success-grad);
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(5, 150, 105, 0.3);
        transition: transform 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-add:hover {
            transform: translateY(-2px);
            color: white;
        }

    /* Tablo Kartı */
    .table-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        border: none;
    }

    .card-header {
        background: transparent;
    }

    .modern-table thead th {
        background-color: #f8f9fa;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 1px solid #e2e8f0;
        padding: 18px 20px;
    }

    .modern-table tbody td {
        padding: 18px 20px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.95rem;
    }

    .modern-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .sakin-adi {
        color: inherit;
    }

    /* Daire İkonu */
    .flat-icon {
        width: 40px;
        height: 40px;
        background: var(--primary-soft);
        color: var(--primary-text);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: 15px;
    }

    .flat-icon-muted {
        background: #f1f5f9;
        color: #64748b;
    }

    /* Yıl Rozeti */
    .badge-year {
        background: #ecfdf5;
        color: #059669;
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 600;
        border: 1px solid #d1fae5;
    }

    .badge-year-muted {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #e2e8f0;
    }

    /* Ay Rozeti */
    .badge-month {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #dbeafe;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        margin: 2px 3px 2px 0;
    }

    .badge-month-muted {
        background: #f8fafc;
        color: #64748b;
        border: 1px solid #e2e8f0;
    }

    /* Silme Butonu */
    .btn-icon-delete {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: #ef4444;
        background: #fef2f2;
        transition: all 0.2s;
        border: 1px solid #fee2e2;
    }

        .btn-icon-delete:hover {
            background: #ef4444;
            color: white;
        }

    /* Düzenle Butonu */
    .btn-icon-edit {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: #2563eb;
        background: #eff6ff;
        transition: all 0.2s;
        border: 1px solid #dbeafe;
    }

        .btn-icon-edit:hover {
            background: #2563eb;
            color: white;
        }

    /* Modal Tasarımı */
    .info-year-card {
        background: #f0fdf4;
        border: 1px dashed #22c55e;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        color: #15803d;
        font-weight: 600;
        margin-top: 20px;
    }

    .btn-cancel-modal {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #e2e8f0;
        font-weight: 500;
        border-radius: 8px;
        padding: 8px 16px;
    }

        .btn-cancel-modal:hover {
            background: #e2e8f0;
            color: #334155;
        }

    /* Ay seçim ızgarası */
    .ay-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-top: 10px;
    }

    .ay-check {
        position: relative;
    }

        .ay-check input {
            position: absolute;
            opacity: 0;
        }

        .ay-check label {
            display: block;
            text-align: center;
            padding: 10px 6px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            color: #64748b;
            transition: all 0.15s;
            user-select: none;
        }

        .ay-check input:checked + label {
            background: var(--success-grad);
            color: #fff;
            border-color: transparent;
        }

    /* Select2 Modal İyileştirmeleri */
    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 48px !important;
        padding: 10px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: normal;
        padding-left: 0;
        color: inherit;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 46px;
        right: 12px;
    }

    .select2-dropdown {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        z-index: 1065 !important;
    }

    .select2-search--dropdown {
        padding: 8px 10px;
    }

    .select2-search--dropdown .select2-search__field {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 0.9rem;
        outline: none;
    }

    .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background-color: #059669;
        color: white;
    }

    /* ===================== DARK MODE (ayrı katman) ===================== */
    html.dark-mode .page-header,
    html.dark-mode .table-card,
    html.dark-mode .accordion-item,
    html.dark-mode .modal-content {
        background: var(--dm-surface) !important;
        border-color: var(--dm-border) !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.35) !important;
    }

    html.dark-mode .page-header h3,
    html.dark-mode .card-title,
    html.dark-mode .sakin-adi,
    html.dark-mode .modal-title {
        color: var(--dm-text) !important;
    }

    html.dark-mode .page-header span,
    html.dark-mode .text-muted {
        color: var(--dm-muted) !important;
    }

    html.dark-mode .card-header {
        background: transparent !important;
        border-bottom-color: var(--dm-border) !important;
    }

    html.dark-mode .modern-table thead th {
        background-color: var(--dm-surface-2) !important;
        color: var(--dm-muted) !important;
        border-bottom-color: var(--dm-border) !important;
    }

    html.dark-mode .modern-table tbody td {
        color: var(--dm-text) !important;
        border-bottom-color: var(--dm-border) !important;
    }

    html.dark-mode .modern-table tbody tr:hover {
        background-color: var(--dm-surface-2) !important;
    }

    html.dark-mode .flat-icon {
        background: rgba(79, 70, 229, 0.2) !important;
        color: #818cf8 !important;
    }

    html.dark-mode .flat-icon-muted {
        background: var(--dm-surface-2) !important;
        color: var(--dm-muted) !important;
    }

    html.dark-mode .badge-year {
        background: rgba(5, 150, 105, 0.2) !important;
        color: #34d399 !important;
        border-color: rgba(5, 150, 105, 0.3) !important;
    }

    html.dark-mode .badge-year-muted {
        background: var(--dm-surface-2) !important;
        color: var(--dm-muted) !important;
        border-color: var(--dm-border) !important;
    }

    html.dark-mode .badge-month {
        background: rgba(37, 99, 235, 0.2) !important;
        color: #60a5fa !important;
        border-color: rgba(37, 99, 235, 0.3) !important;
    }

    html.dark-mode .badge-month-muted {
        background: var(--dm-surface-2) !important;
        color: var(--dm-muted) !important;
        border-color: var(--dm-border) !important;
    }

    html.dark-mode .btn-icon-delete {
        background: rgba(239, 68, 68, 0.15) !important;
        border-color: rgba(239, 68, 68, 0.25) !important;
        color: #f87171 !important;
    }

        html.dark-mode .btn-icon-delete:hover {
            background: #ef4444 !important;
            color: #ffffff !important;
        }

    html.dark-mode .btn-icon-edit {
        background: rgba(37, 99, 235, 0.15) !important;
        border-color: rgba(37, 99, 235, 0.25) !important;
        color: #60a5fa !important;
    }

        html.dark-mode .btn-icon-edit:hover {
            background: #2563eb !important;
            color: #ffffff !important;
        }

    html.dark-mode .info-year-card {
        background: rgba(5, 150, 105, 0.15) !important;
        border-color: rgba(5, 150, 105, 0.35) !important;
        color: #34d399 !important;
    }

    html.dark-mode .ay-check label {
        background: var(--dm-surface-2) !important;
        border-color: var(--dm-border) !important;
        color: var(--dm-muted) !important;
    }

        html.dark-mode .ay-check label:hover {
            color: var(--dm-text) !important;
            border-color: var(--dm-primary) !important;
        }

    html.dark-mode .ay-check input:checked + label {
        background: var(--success-grad) !important;
        color: #ffffff !important;
        border-color: transparent !important;
    }

    html.dark-mode .accordion-button {
        background: var(--dm-surface) !important;
        color: var(--dm-text) !important;
    }

        html.dark-mode .accordion-button:not(.collapsed) {
            background: var(--dm-surface-2) !important;
            color: var(--dm-primary) !important;
        }

        html.dark-mode .accordion-button::after {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

    html.dark-mode .btn-cancel-modal {
        background: var(--dm-surface-2) !important;
        border-color: var(--dm-border) !important;
        color: var(--dm-muted) !important;
    }

        html.dark-mode .btn-cancel-modal:hover {
            color: var(--dm-text) !important;
        }

    /* Select2 Dark Mode */
    html.dark-mode .select2-container--default .select2-selection--single {
        background-color: var(--dm-surface-2) !important;
        border-color: var(--dm-border) !important;
    }

        html.dark-mode .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: var(--dm-text) !important;
        }

        html.dark-mode .select2-container--default .select2-selection--single .select2-selection__arrow b {
            border-color: var(--dm-muted) transparent transparent transparent !important;
        }

    html.dark-mode .select2-dropdown {
        background-color: var(--dm-surface) !important;
        border-color: var(--dm-border) !important;
    }

    html.dark-mode .select2-search--dropdown .select2-search__field {
        background-color: var(--dm-surface-2) !important;
        border-color: var(--dm-border) !important;
        color: var(--dm-text) !important;
    }

    html.dark-mode .select2-container--default .select2-results__option--selectable {
        background-color: var(--dm-surface) !important;
        color: var(--dm-text) !important;
    }

    html.dark-mode .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background-color: #059669 !important;
        color: #ffffff !important;
    }
</style>

<div class="container-fluid py-4">

    <!-- ================= YILLIK PEŞİN ÖDEMELER ================= -->
    <div class="page-header">
        <div>
            <h3 class="fw-bold mb-0">Peşin Ödemeler</h3>
            <span class="text-muted small">Yıllık peşin ödeme yapan dairelerin listesi</span>
        </div>
        <button type="button" class="btn-add" data-bs-toggle="modal" data-bs-target="#verticalycentered">
            <i class="bi bi-credit-card-2-front-fill"></i> Ödeme Ekle
        </button>
    </div>

    <div class="card table-card mb-4">
        <div class="card-header border-0 pt-4 px-4">
            <h5 class="card-title fw-bold mb-0"><i class="bi bi-list-check me-2 text-primary"></i>Yıllık Ödeme Listesi</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table modern-table mb-0 datatable">
                    <thead>
                        <tr>
                            <th scope="col">Daire Bilgisi</th>
                            <th scope="col">Peşin Ödenen Yıl</th>
                            <th scope="col" class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.List)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="flat-icon">@item.DaireNo</div>
                                        <div>
                                            <div class="fw-bold sakin-adi">@item.AdSoyad</div>
                                            <div class="small text-muted">Daire No: @item.DaireNo</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-year">
                                        <i class="bi bi-calendar-check me-1"></i> @item.Yil
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="#" class="btn-icon-delete ms-auto" onclick="confirmDeleteExpense(event, @item.ID)" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= AYLIK PEŞİN ÖDEMELER (AKTİF) ================= -->
    <div class="page-header mt-4">
        <div>
            <h3 class="fw-bold mb-0">Aylık Peşin Ödemeler</h3>
            <span class="text-muted small">Aktif peşin ödeme yapan daireler (@simdikiYil - @(simdikiYil + 1))</span>
        </div>
        <button type="button" class="btn-add" data-bs-toggle="modal" data-bs-target="#aylikEkleModal">
            <i class="bi bi-calendar2-range-fill"></i> Aylık Ödeme Ekle
        </button>
    </div>

    <div class="card table-card">
        <div class="card-header border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0"><i class="bi bi-calendar3 me-2 text-success"></i>Aktif Aylık Ödeme Listesi</h5>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill small">
                <i class="bi bi-check-circle me-1"></i>Aktif Kayıtlar
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table modern-table mb-0 @(ViewBag.AylikList != null && ViewBag.AylikList.Count > 0 ? "datatable" : "")">
                    <thead>
                        <tr>
                            <th scope="col">Daire Bilgisi</th>
                            <th scope="col">Yıl</th>
                            <th scope="col">Peşin Ödenen Aylar</th>
                            <th scope="col" class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.AylikList != null && ViewBag.AylikList.Count > 0)
                        {
                            foreach (var item in ViewBag.AylikList)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="flat-icon">@item.DaireNo</div>
                                            <div>
                                                <div class="fw-bold sakin-adi">@item.AdSoyad</div>
                                                <div class="small text-muted">Daire No: @item.DaireNo</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge-year"><i class="bi bi-calendar-check me-1"></i> @item.Yil</span></td>
                                    <td>
                                        @foreach (var ay in (List<int>)item.Aylar)
                                        {
                                            <span class="badge-month">@ayAdlari[ay]</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn-icon-edit me-1"
                                                onclick="aylikDuzenle(@item.DaireID, @item.Yil, '@string.Join(",", (List<int>)item.Aylar)', '@item.DaireNo', '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.AdSoyad))')"
                                                title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <a href="#" class="btn-icon-delete" onclick="aylikSil(event, @item.DaireID, @item.Yil)" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox me-1"></i>Aktif aylık peşin ödeme kaydı bulunmamaktadır.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= GEÇMİŞ PEŞİN ÖDEMELER ================= -->
    <div class="accordion my-4 shadow-sm rounded-4 overflow-hidden" id="accordionGecmisAylik">
        <div class="accordion-item border-0">
            <h2 class="accordion-header" id="headingGecmisAylik">
                <button class="accordion-button collapsed fw-bold py-3 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#collapseGecmisAylik" aria-expanded="false" aria-controls="collapseGecmisAylik">
                    <i class="bi bi-clock-history me-2 text-primary fs-5"></i> Geçmiş Peşin Ödemeler
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 ms-2 rounded-pill">@(ViewBag.AylikGecmisList != null ? ViewBag.AylikGecmisList.Count : 0)</span>
                </button>
            </h2>
            <div id="collapseGecmisAylik" class="accordion-collapse collapse" aria-labelledby="headingGecmisAylik" data-bs-parent="#accordionGecmisAylik">
                <div class="accordion-body p-0">
                    <div class="table-responsive">
                        <table class="table modern-table mb-0 @(ViewBag.AylikGecmisList != null && ViewBag.AylikGecmisList.Count > 0 ? "datatable" : "")">
                            <thead>
                                <tr>
                                    <th scope="col">Daire Bilgisi</th>
                                    <th scope="col">Yıl</th>
                                    <th scope="col">Geçmiş Ödenen Aylar</th>
                                    <th scope="col">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.AylikGecmisList != null && ViewBag.AylikGecmisList.Count > 0)
                                {
                                    foreach (var item in ViewBag.AylikGecmisList)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="flat-icon flat-icon-muted">@item.DaireNo</div>
                                                    <div>
                                                        <div class="fw-bold sakin-adi">@item.AdSoyad</div>
                                                        <div class="small text-muted">Daire No: @item.DaireNo</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge-year badge-year-muted">
                                                    <i class="bi bi-calendar-check me-1"></i> @item.Yil
                                                </span>
                                            </td>
                                            <td>
                                                @foreach (var ay in (List<int>)item.Aylar)
                                                {
                                                    <span class="badge-month badge-month-muted">@ayAdlari[ay]</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                                    <i class="bi bi-check2-circle me-1 text-success"></i>Dönemi Geçti
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="bi bi-info-circle me-1"></i>Geçmiş peşin ödeme kaydı bulunmamaktadır.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- YILLIK PEŞİN ÖDEME EKLE MODAL -->
<div class="modal fade" id="verticalycentered" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-success">
                    <i class="bi bi-wallet-fill me-2"></i>Peşin Ödeme Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form action="/AnaSayfa/PesinOdemeEkle" method="post" class="p-3">
                <div class="modal-body">
                    <label class="fw-bold small mb-2 text-muted text-uppercase">Daire Seçimi</label>
                    <select name="DaireID" id="selectDaireYillik" class="form-select select2-daire" required>
                        <option value="">-- Daire Ara / Seçiniz --</option>
                        @foreach (var item in ViewBag.Daireler)
                        {
                            <option value="@item.DaireID">Daire @item.DaireNo - @item.AdSoyad</option>
                        }
                    </select>

                    <div class="info-year-card">
                        <i class="bi bi-calendar-event me-2"></i>
                        PEŞİN ÖDENEN YIL : @simdikiYil
                    </div>
                    <p class="text-muted small text-center mt-2">
                        Seçilen daire için @simdikiYil yılına ait aidat borçları otomatik olarak "Ödendi" durumuna geçecektir.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-cancel-modal" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success px-4" style="background: var(--success-grad); border:none;">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- AYLIK PEŞİN ÖDEME EKLE MODAL -->
<div class="modal fade" id="aylikEkleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-success">
                    <i class="bi bi-calendar2-range-fill me-2"></i>Aylık Peşin Ödeme Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="aylikEkleForm" action="/AnaSayfa/AylikPesinOdemeEkle" method="post" class="p-3" onsubmit="return aylikSubmitKontrol(this);">
                <div class="modal-body">
                    <label class="fw-bold small mb-2 text-muted text-uppercase">Daire Seçimi</label>
                    <select name="DaireID" id="selectDaireAylik" class="form-select select2-daire" required>
                        <option value="">-- Daire Ara / Seçiniz --</option>
                        @foreach (var item in ViewBag.Daireler)
                        {
                            <option value="@item.DaireID">Daire @item.DaireNo - @item.AdSoyad</option>
                        }
                    </select>

                    <label class="fw-bold small mb-2 mt-3 text-muted text-uppercase d-block">Peşin Ödenen Aylar (@simdikiYil)</label>
                    <div class="ay-grid">
                        @for (int a = simdikiAy; a <= 12; a++)
                        {
                            <div class="ay-check">
                                <input type="checkbox" name="YilAylar" value="@simdikiYil-@a" id="ekle_ay_@(simdikiYil)_@a" />
                                <label for="ekle_ay_@(simdikiYil)_@a">@ayAdlari[a]</label>
                            </div>
                        }
                    </div>

                    <label class="fw-bold small mb-2 mt-3 text-muted text-uppercase d-block">Peşin Ödenen Aylar (@(simdikiYil + 1))</label>
                    <div class="ay-grid">
                        @for (int a = 1; a <= 12; a++)
                        {
                            <div class="ay-check">
                                <input type="checkbox" name="YilAylar" value="@(simdikiYil + 1)-@a" id="ekle_ay_@(simdikiYil + 1)_@a" />
                                <label for="ekle_ay_@(simdikiYil + 1)_@a">@ayAdlari[a]</label>
                            </div>
                        }
                    </div>
                    <p class="text-muted small text-center mt-3 mb-0">
                        Seçilen aylar, dönem eklenirken borç oluşturmadan otomatik "Ödendi" (makbuzlu) işlenir. Geçmiş aylar listelenmez.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-cancel-modal" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success px-4" style="background: var(--success-grad); border:none;">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- AYLIK PEŞİN ÖDEME DÜZENLE MODAL -->
<div class="modal fade" id="aylikDuzenleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-primary">
                    <i class="bi bi-pencil-square me-2"></i>Aylık Ödeme Düzenle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="aylikDuzenleForm" action="/AnaSayfa/AylikPesinOdemeGuncelle" method="post" class="p-3" onsubmit="return aylikSubmitKontrol(this);">
                <input type="hidden" name="DaireID" id="duzenle_DaireID" />
                <input type="hidden" name="Yil" id="duzenle_Yil" />
                <div class="modal-body">
                    <div class="info-year-card mb-3" id="duzenle_baslik"></div>
                    <label class="fw-bold small mb-2 text-muted text-uppercase d-block" id="duzenle_aylar_baslik">Peşin Ödenen Aktif Aylar (@simdikiYil)</label>
                    <div class="ay-grid">
                        @for (int a = 1; a <= 12; a++)
                        {
                            <div class="ay-check duzenle-ay-item" data-ay="@a">
                                <input type="checkbox" name="Aylar" value="@a" id="duzenle_ay_@a" />
                                <label for="duzenle_ay_@a">@ayAdlari[a]</label>
                            </div>
                        }
                    </div>
                    <p class="text-muted small text-center mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Geçmiş aylara ait ödemeler geçmiş kayıt olarak korunur; buradan yalnızca aktif aylar güncellenebilir.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-cancel-modal" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary px-4">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function() {
        @if (TempData["Hata"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'error',
                    title: 'HATA!',
                    text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Hata"].ToString()))',
                    confirmButtonColor: '#d33'
                });
            </text>
        }

        @if (TempData["Basarili"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["Basarili"].ToString()))',
                    confirmButtonColor: '#059669'
                });
            </text>
        }

        // Select2 Daire Arama Kutuları
        $('#verticalycentered').on('shown.bs.modal', function () {
            if (!$('#selectDaireYillik').hasClass("select2-hidden-accessible")) {
                $('#selectDaireYillik').select2({
                    dropdownParent: $('#verticalycentered'),
                    width: '100%',
                    placeholder: '-- Daire Ara / Seçiniz --'
                });
            }
        });

        $('#aylikEkleModal').on('shown.bs.modal', function () {
            if (!$('#selectDaireAylik').hasClass("select2-hidden-accessible")) {
                $('#selectDaireAylik').select2({
                    dropdownParent: $('#aylikEkleModal'),
                    width: '100%',
                    placeholder: '-- Daire Ara / Seçiniz --'
                });
            }
        });
    });

    // Modern Silme Onayı
    function confirmDeleteExpense(event, id) {
        event.preventDefault();

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu peşin ödeme kaydını silmek istediğinize emin misiniz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/AnaSayfa/PesinOdemeSil/' + id;
            }
        });
    }

    // ===== AYLIK PEŞİN ÖDEME =====

    var SIMDIKI_YIL = @simdikiYil;
    var SIMDIKI_AY = @simdikiAy;

    // Ay adları (uyarı metni için)
    var AY_ADLARI = ['', 'Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];

    // Seçili ayları (yıl*12 + ay sırasıyla) toplar
    function seciliAylar(form) {
        if (form.id === 'aylikEkleForm') {
            return Array.from(form.querySelectorAll('input[name="YilAylar"]:checked'))
                        .map(function (c) {
                            var p = c.value.split('-');
                            var y = parseInt(p[0], 10);
                            var a = parseInt(p[1], 10);
                            return { yil: y, ay: a, idx: y * 12 + a, label: y + ' ' + AY_ADLARI[a] };
                        })
                        .sort(function (x, y) { return x.idx - y.idx; });
        }

        var dYil = parseInt(document.getElementById('duzenle_Yil').value, 10) || SIMDIKI_YIL;
        return Array.from(form.querySelectorAll('input[name="Aylar"]:checked'))
                    .map(function (c) {
                        var a = parseInt(c.value, 10);
                        return { yil: dYil, ay: a, idx: dYil * 12 + a, label: AY_ADLARI[a] };
                    })
                    .sort(function (x, y) { return x.idx - y.idx; });
    }

    // Ardışık mı? (atlanan ay var mı? Yıl geçişi dahil: 2026 Aralık -> 2027 Ocak ardışıktır)
    function aylarArdisikMi(aylar) {
        for (var i = 0; i < aylar.length - 1; i++) {
            if (aylar[i + 1].idx - aylar[i].idx !== 1) return false;
        }
        return true;
    }

    // Submit kontrolü: en az 1 ay + atlama (boşluk) uyarısı
    function aylikSubmitKontrol(form) {
        var aylar = seciliAylar(form);

        if (aylar.length === 0) {
            Swal.fire({ icon: 'error', title: 'Ay seçilmedi', text: 'En az bir ay seçmelisiniz.', confirmButtonColor: '#d33' });
            return false;
        }

        if (!aylarArdisikMi(aylar)) {
            var secili = aylar.map(function (item) { return item.label; }).join(', ');
            Swal.fire({
                title: 'Ay atlanmış olabilir!',
                html: 'Seçtiğiniz aylar ardışık değil:<br><b>' + secili + '</b><br><br>Arada atladığınız ay(lar) var. Yine de kaydetmek istiyor musunuz?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#6b7280',
                confirmButtonText: 'Evet, kaydet',
                cancelButtonText: 'Geri dön, düzelteyim'
            }).then(function (result) {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
            return false;
        }

        return true;
    }

    // Düzenle modalını doldur
    function aylikDuzenle(daireID, yil, aylarCsv, daireNo, adSoyad) {
        document.getElementById('duzenle_DaireID').value = daireID;
        document.getElementById('duzenle_Yil').value = yil;
        document.getElementById('duzenle_baslik').innerHTML =
            '<i class="bi bi-house-door me-2"></i>Daire ' + daireNo + ' - ' + adSoyad + ' (' + yil + ')';
        document.getElementById('duzenle_aylar_baslik').textContent = 'Peşin Ödenen Aktif Aylar (' + yil + ')';

        document.querySelectorAll('#aylikDuzenleModal .duzenle-ay-item').forEach(function (el) {
            var ay = parseInt(el.getAttribute('data-ay'), 10);
            var cb = el.querySelector('input[name="Aylar"]');
            cb.checked = false;

            if (yil === SIMDIKI_YIL && ay < SIMDIKI_AY) {
                el.style.display = 'none';
                cb.disabled = true;
            } else {
                el.style.display = '';
                cb.disabled = false;
            }
        });

        if (aylarCsv && aylarCsv.length > 0) {
            aylarCsv.split(',').forEach(function (v) {
                var el = document.getElementById('duzenle_ay_' + parseInt(v, 10));
                if (el && !el.disabled) el.checked = true;
            });
        }

        var modal = new bootstrap.Modal(document.getElementById('aylikDuzenleModal'));
        modal.show();
    }

    // Aylık kaydı sil
    function aylikSil(event, daireID, yil) {
        event.preventDefault();
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu dairenin aktif aylık peşin ödeme kaydını silmek istediğinize emin misiniz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        }).then(function (result) {
            if (result.isConfirmed) {
                window.location.href = '/AnaSayfa/AylikPesinOdemeSil?DaireID=' + daireID + '&Yil=' + yil;
            }
        });
    }
</script>
