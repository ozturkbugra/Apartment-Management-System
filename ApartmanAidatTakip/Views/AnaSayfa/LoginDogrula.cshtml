@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>Apartman Aidat Yazılımı - İki Adımlı Doğrulama</title>

    <!-- Favicons -->
    <link href="/Content/Admin/assets/img/favicon.png" rel="icon">
    <link href="/Content/Admin/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="/Content/Admin/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/Content/Admin/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">

    <!-- Dark Mode (localStorage) -->
    <link href="/Content/Admin/assets/css/darkmode.css" rel="stylesheet">
    <script src="/Content/Admin/assets/js/darkmode.js"></script>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f6fa;
        }

        .container {
            max-width: 400px;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .card-body {
            padding: 2rem;
        }

        .form-control {
            border-radius: 10px;
        }

        .code-input {
            letter-spacing: 0.6rem;
            text-align: center;
            font-size: 1.4rem;
            font-weight: 600;
        }

        .btn-success {
            border-radius: 10px;
            font-weight: 600;
            background-color: #28a745;
        }

            .btn-success:hover {
                background-color: #218838;
            }

        .auth-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f46e5 0%, #818cf8 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: #fff;
            margin: 0 auto 1rem auto;
        }
    </style>
</head>

<body>
    <main>
        <div class="container d-flex flex-column align-items-center justify-content-center min-vh-100">
            <section class="section register d-flex flex-column align-items-center justify-content-center py-4">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 d-flex flex-column align-items-center justify-content-center">

                            <div class="card">
                                <div class="card-body">

                                    <div class="auth-icon">
                                        <i class="bi bi-shield-lock-fill"></i>
                                    </div>

                                    <h5 class="card-title text-center mb-2">İki Adımlı Doğrulama</h5>

                                    <form method="post" action="/AnaSayfa/LoginDogrula" class="row g-3">

                                        @if (!string.IsNullOrEmpty(ViewBag.Uyari))
                                        {
                                            <div class="col-12">
                                                <div class="alert alert-danger text-center mb-0">@ViewBag.Uyari</div>
                                            </div>
                                        }

                                        <!-- MOD 1: Authenticator kodu (varsayılan) -->
                                        <div id="modAuth" class="col-12">
                                            <p class="text-center text-muted small mb-3">
                                                Google Authenticator uygulamanızdaki <b>6 haneli</b> kodu giriniz.
                                            </p>
                                            <input type="text" id="authKod" name="kod" class="form-control code-input"
                                                   inputmode="numeric" autocomplete="one-time-code"
                                                   maxlength="6" placeholder="______" autofocus>
                                            <div class="text-center mt-3">
                                                <a href="#" id="linkYedek" class="small">Telefonuma erişemiyorum, yedek kod kullan</a>
                                            </div>
                                        </div>

                                        <!-- MOD 2: Yedek kod -->
                                        <div id="modYedek" class="col-12" style="display:none;">
                                            <p class="text-center text-muted small mb-3">
                                                Aktifleştirme sırasında size verilen <b>yedek kodlardan</b> birini giriniz.
                                            </p>
                                            <input type="text" id="yedekKod" name="kod" class="form-control text-center"
                                                   autocomplete="off" maxlength="11" placeholder="xxxxx-xxxxx" disabled
                                                   style="font-family:monospace; font-size:1.15rem; letter-spacing:2px;">
                                            <div class="text-center mt-3">
                                                <a href="#" id="linkAuth" class="small">Authenticator kodu ile giriş yap</a>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <button class="btn btn-success w-100" type="submit">Doğrula ve Giriş Yap</button>
                                        </div>

                                        <div class="col-12 text-center">
                                            <p class="small mb-0"><a href="/AnaSayfa/Login">Girişe geri dön</a></p>
                                        </div>
                                    </form>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script src="/Content/Admin/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var modAuth = document.getElementById('modAuth');
            var modYedek = document.getElementById('modYedek');
            var authKod = document.getElementById('authKod');
            var yedekKod = document.getElementById('yedekKod');

            function yedekMod(e) {
                if (e) e.preventDefault();
                modAuth.style.display = 'none';
                modYedek.style.display = 'block';
                authKod.disabled = true;   // devre dışı input submit edilmez
                yedekKod.disabled = false;
                yedekKod.focus();
            }

            function authMod(e) {
                if (e) e.preventDefault();
                modYedek.style.display = 'none';
                modAuth.style.display = 'block';
                yedekKod.disabled = true;
                authKod.disabled = false;
                authKod.focus();
            }

            document.getElementById('linkYedek').addEventListener('click', yedekMod);
            document.getElementById('linkAuth').addEventListener('click', authMod);
        })();
    </script>
</body>

</html>
